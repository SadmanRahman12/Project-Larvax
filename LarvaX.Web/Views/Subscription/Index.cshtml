                        </button>
                    </h2>
                    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            @(isBn 
                                ? "অবশ্যই। কোনো লুকানো চার্জ নেই। আপনার 'মাই সাবস্ক্রিপশন' পেজ থেকে এক ক্লিকে যেকোনো সময় অটো-রিনিউ বাতিল করতে পারেন। আপনি বর্তমান বিলিং সাইকেলের শেষ দিন পর্যন্ত সব সুবিধা উপভোগ করতে পারবেন।"
                                : "Absolutely. You can cancel auto-renewal anytime with one click directly from your 'My Subscription' dashboard. You keep all premium access until the end of your prepaid period.")
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                            @(isBn ? "পারিবারিক প্রোফাইল কীভাবে কাজ করে?" : "How do family profiles work?")
                        </button>
                    </h2>
                    <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            @(isBn 
                                ? "সিটিজেন প্রিমিয়াম প্ল্যানে আপনি আপনার সন্তান, বাবা-মা বা পরিবারের অন্যান্য সদস্যদের (সর্বোচ্চ ৬ জন) যুক্ত করে প্রত্যেকের রক্তের গ্রুপ, ডেঙ্গু উপসর্গ ও হাইড্রেশন পৃথকভাবে ট্র্যাক করতে পারেন।"
                                : "With Citizen Premium, you can add up to 6 family members (children, parents, spouse) and track their individual symptoms, blood groups, and hydration schedules under one single account.")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const billingToggle = document.getElementById('billingToggle');
        const monthlyViews = document.querySelectorAll('.price-monthly-view');
        const yearlyViews = document.querySelectorAll('.price-yearly-view');
        const btnPlanSelects = document.querySelectorAll('.btn-plan-select');
        const btnMonthly = document.getElementById('btnMonthly');
        const btnYearly = document.getElementById('btnYearly');

        function updateBillingView(isYearly) {
            if (isYearly) {
                monthlyViews.forEach(el => el.classList.add('d-none'));
                yearlyViews.forEach(el => el.classList.remove('d-none'));
                btnPlanSelects.forEach(btn => {
                    const planId = btn.getAttribute('data-plan-id');
                    btn.href = `/Subscription/Checkout?planId=${planId}&cycle=Yearly`;
                });
                btnYearly.classList.remove('text-muted');
                btnMonthly.classList.add('text-muted');
            } else {
                monthlyViews.forEach(el => el.classList.remove('d-none'));
                yearlyViews.forEach(el => el.classList.add('d-none'));
                btnPlanSelects.forEach(btn => {
                    const planId = btn.getAttribute('data-plan-id');
                    btn.href = `/Subscription/Checkout?planId=${planId}&cycle=Monthly`;
                });
                btnMonthly.classList.remove('text-muted');
                btnYearly.classList.add('text-muted');
            }
        }

        billingToggle.addEventListener('change', function () {
            updateBillingView(this.checked);
        });

        btnMonthly.addEventListener('click', () => {
            billingToggle.checked = false;
            updateBillingView(false);
        });

        btnYearly.addEventListener('click', () => {
            billingToggle.checked = true;
            updateBillingView(true);
        });
    </script>
}
