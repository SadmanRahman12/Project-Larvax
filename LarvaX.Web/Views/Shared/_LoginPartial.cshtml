@using Microsoft.AspNetCore.Identity
@using LarvaX.Core.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var roles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var primaryRole = roles.FirstOrDefault() ?? "Citizen";

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-white fw-semibold d-flex align-items-center gap-1" href="#" id="userProfileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle fs-5 text-warning"></i>
            <span>@(currentUser?.FullName ?? User.Identity?.Name)</span>
            <span class="badge bg-light text-success ms-1 small">@primaryRole</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2" aria-labelledby="userProfileDropdown">
            <li class="px-3 py-2 border-bottom">
                <div class="fw-bold text-dark">@(currentUser?.FullName ?? "User")</div>
                <small class="text-muted text-break">@User.Identity?.Name</small>
            </li>
            <li>
                <a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2 text-primary"></i>User Dashboard
                </a>
            </li>
            <li>
                <a class="dropdown-item py-2" asp-controller="PatientRecords" asp-action="Index">
                    <i class="bi bi-folder2-open me-2 text-success"></i>My Health Records
                </a>
            </li>
            <li>
                <a class="dropdown-item py-2" asp-controller="Telemedicine" asp-action="Appointments">
                    <i class="bi bi-camera-video me-2 text-info"></i>My Appointments
                </a>
            </li>
            <li>
                <a class="dropdown-item py-2" asp-controller="Lab" asp-action="Bookings">
                    <i class="bi bi-eyedropper me-2 text-danger"></i>My Lab Bookings
                </a>
            </li>
            <li>
                <a class="dropdown-item py-2" asp-controller="Subscription" asp-action="MySubscription">
                    <i class="bi bi-star-fill me-2 text-warning"></i>My Subscription & Billing
                </a>
            </li>
            @if (User.IsInRole("Administrator"))
            {
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item py-2 text-danger fw-semibold" asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-shield-lock me-2"></i>Admin Console
                    </a>
                </li>
            }
            @if (User.IsInRole("GovernmentAuthority") || User.IsInRole("Administrator"))
            {
                <li>
                    <a class="dropdown-item py-2 text-warning fw-semibold" asp-controller="Government" asp-action="Dashboard">
                        <i class="bi bi-shield-check me-2"></i>Government Dashboard
                    </a>
                </li>
            }
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="d-inline" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item py-2 text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus me-1"></i>Register
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>Login
        </a>
    </li>
}
</ul>
