<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LarvaX Dengue Platform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LarvaX.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-success border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-shaded me-1"></i>LarvaX <span class="badge bg-warning text-dark small fs-6">Dengue Sentinel</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Reports" asp-action="Create"><i class="bi bi-geo-alt-fill me-1"></i>Report Hazard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Reports" asp-action="Index"><i class="bi bi-list-check me-1"></i>Community Reports</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="healthServicesNav" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-heart-pulse me-1"></i>Health Tools
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="healthServicesNav">
                                <li><a class="dropdown-item" asp-controller="SymptomChecker" asp-action="Index"><i class="bi bi-clipboard2-pulse me-2 text-danger"></i>AI Symptom Checker</a></li>
                                <li><a class="dropdown-item" asp-controller="FirstAid" asp-action="Index"><i class="bi bi-heart-pulse me-2 text-danger"></i>First Aid Guide</a></li>
                                <li><a class="dropdown-item" asp-controller="Chatbot" asp-action="Index"><i class="bi bi-chat-dots me-2 text-primary"></i>DenAI Chatbot</a></li>
                                <li><a class="dropdown-item" asp-controller="Education" asp-action="Index"><i class="bi bi-book-half me-2 text-success"></i>Awareness & Education</a></li>
                                <li><a class="dropdown-item" asp-controller="FluidManagement" asp-action="Index"><i class="bi bi-droplet-half me-2 text-primary"></i>Fluid Management</a></li>
                                <li><a class="dropdown-item" asp-controller="FluidManagement" asp-action="Planner"><i class="bi bi-calendar3 me-2 text-warning"></i>Oral Rehydration Planner</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Donors" asp-action="Index"><i class="bi bi-droplet-fill me-2 text-danger"></i>Blood Donor Network</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Education" asp-action="Index"><i class="bi bi-journal-text me-1"></i>Education</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="FluidManagement" asp-action="Index"><i class="bi bi-droplet-half me-1"></i>Fluid Management</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="IcuBeds" asp-action="Index"><i class="bi bi-hospital me-1"></i>ICU Bed Finder</a>
                        </li>
                        @if (User.IsInRole("GovernmentAuthority") || User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Government" asp-action="Dashboard"><i class="bi bi-shield-check me-1"></i>Government Dashboard</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-area="" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Admin Console</a>
                            </li>
                        }
                    </ul>
                    <form asp-controller="Language" asp-action="SetLanguage" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" method="post" class="d-flex align-items-center me-2">
                        <div class="dropdown">
                            <button class="btn btn-outline-light btn-sm dropdown-toggle rounded-pill px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-translate me-1"></i> @(System.Globalization.CultureInfo.CurrentUICulture.Name == "bn" ? "বাংলা" : "English")
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li>
                                    <button type="submit" name="culture" value="en" class="dropdown-item d-flex align-items-center justify-content-between">
                                        <span>🇬🇧 English</span>
                                        @(System.Globalization.CultureInfo.CurrentUICulture.Name == "en" ? Html.Raw("<i class='bi bi-check text-success'></i>") : null)
                                    </button>
                                </li>
                                <li>
                                    <button type="submit" name="culture" value="bn" class="dropdown-item d-flex align-items-center justify-content-between">
                                        <span>🇧🇩 বাংলা</span>
                                        @(System.Globalization.CultureInfo.CurrentUICulture.Name == "bn" ? Html.Raw("<i class='bi bi-check text-success'></i>") : null)
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </form>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Live Real-Time SignalR Alert Notification Toast -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        <div id="liveSignalRAlertToast" class="toast align-items-center text-bg-danger border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <div class="fw-bold mb-1"><i class="bi bi-broadcast-pin me-1"></i> <span id="toastAlertTitle">Dengue Sentinel Real-time Alert</span></div>
                    <div id="toastAlertMessage">High risk activity detected.</div>
                    <small class="text-white-50 mt-1 d-block" id="toastAlertTime"></small>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - LarvaX.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof signalR !== "undefined") {
                const alertConnection = new signalR.HubConnectionBuilder()
                    .withUrl("/alertshub")
                    .withAutomaticReconnect()
                    .build();

                alertConnection.on("ReceiveAlert", function (alert) {
                    const isBn = "@(System.Globalization.CultureInfo.CurrentUICulture.Name)" === "bn";
                    const msg = (isBn && alert.messageBn) ? alert.messageBn : alert.message;
                    document.getElementById("toastAlertMessage").textContent = msg;
                    document.getElementById("toastAlertTime").textContent = new Date(alert.sentAt).toLocaleTimeString();
                    const toastEl = document.getElementById("liveSignalRAlertToast");
                    const toast = new bootstrap.Toast(toastEl, { delay: 12000 });
                    toast.show();
                });

                alertConnection.start().catch(function(err) {
                    console.debug("AlertsHub signalr connection notice:", err);
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
