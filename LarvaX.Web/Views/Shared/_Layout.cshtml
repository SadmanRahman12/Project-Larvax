<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LarvaX Dengue Platform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LarvaX.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-success border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-shaded me-1"></i>LarvaX <span class="badge bg-warning text-dark small fs-6">Dengue Sentinel</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Reports" asp-action="Create"><i class="bi bi-geo-alt-fill me-1"></i>Report Hazard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Reports" asp-action="Index"><i class="bi bi-list-check me-1"></i>Community Reports</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="healthServicesNav" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-heart-pulse me-1"></i>Health Tools
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="healthServicesNav">
                                <li><a class="dropdown-item" asp-controller="SymptomChecker" asp-action="Index"><i class="bi bi-clipboard2-pulse me-2 text-danger"></i>AI Symptom Checker</a></li>
                                <li><a class="dropdown-item" asp-controller="FirstAid" asp-action="Index"><i class="bi bi-heart-pulse me-2 text-danger"></i>First Aid Guide</a></li>
                                <li><a class="dropdown-item" asp-controller="Chatbot" asp-action="Index"><i class="bi bi-chat-dots me-2 text-primary"></i>DenAI Chatbot</a></li>
                                <li><a class="dropdown-item" asp-controller="Education" asp-action="Index"><i class="bi bi-book-half me-2 text-success"></i>Awareness & Education</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Donors" asp-action="Index"><i class="bi bi-droplet-fill me-2 text-danger"></i>Blood Donor Network</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Education" asp-action="Index"><i class="bi bi-journal-text me-1"></i>Education</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="IcuBeds" asp-action="Index"><i class="bi bi-hospital me-1"></i>ICU Bed Finder</a>
                        </li>
                        @if (User.IsInRole("GovernmentAuthority") || User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Government" asp-action="Dashboard"><i class="bi bi-shield-check me-1"></i>Government Dashboard</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-area="" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Admin Console</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - LarvaX.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
