@{
    ViewData["Title"] = "About LarvaX";
}

<div class="container mt-4">
    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-body">
            <h2 class="fw-bold">About LarvaX</h2>
            <p class="text-muted">LarvaX is an open-source dengue sentinel platform providing community reporting, risk mapping, telemedicine access, and health education tools. Our goal is to help communities detect and respond to dengue outbreaks faster.</p>

            <h5 class="mt-4">Key features</h5>
            <ul>
                <li>Community hazard reporting and verification</li>
                <li>Government &amp; laboratory dashboards</li>
                <li>AI-powered symptom checker and chatbot</li>
                <li>Telemedicine and appointment management</li>
            </ul>

            <h5 class="mt-4">Get involved</h5>
            <p class="text-muted">Contribute on GitHub, report issues, or join the community to help improve public health surveillance.</p>

            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Back to Home</a>
        </div>
    </div>
</div>
