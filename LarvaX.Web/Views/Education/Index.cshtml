@model LarvaX.Web.Controllers.EducationOverviewViewModel
@{
    ViewData["Title"] = "Awareness & Education";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">Awareness & Education</h2>
    <p class="text-muted mb-0">Practical dengue guidance, local prevention tips, and myth-busting resources.</p>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">Prevention checklist</h4>
                <ul class="mb-0">
                    @foreach (var tip in Model.PreventionTips)
                    {
                        <li class="mb-2">@tip</li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">Seek urgent care if</h4>
                <ul class="mb-0">
                    @foreach (var sign in Model.WarningSigns)
                    {
                        <li class="mb-2">@sign</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="mb-4">
    <h4 class="fw-bold">Browse related articles</h4>
</div>

<div class="row g-4">
    @foreach (var article in Model.Articles)
    {
        <div class="col-md-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-primary-subtle text-primary align-self-start mb-2">@article.Category</span>
                    <h5 class="card-title fw-bold">@article.Title</h5>
                    <p class="card-text text-muted flex-grow-1">@article.Summary</p>
                    <a href="@article.Url" target="_blank" rel="noopener" class="btn btn-outline-primary mt-2">Read article</a>
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-5 text-center">
    <a asp-action="Quiz" class="btn btn-danger btn-lg">Take the dengue awareness quiz</a>
</div>
