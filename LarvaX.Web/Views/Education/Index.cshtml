@using LarvaX.Core.Entities
@model IEnumerable<Article>
@{
    ViewData["Title"] = "Awareness & Education";
    var quizzes = ViewBag.Quizzes as IEnumerable<Quiz> ?? Enumerable.Empty<Quiz>();
    var isBn = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("bn");
}

<div class="container-fluid py-4" style="max-width:1140px">
    <!-- Hero -->
    <div class="rounded-4 p-4 p-md-5 mb-5 position-relative overflow-hidden"
         style="background: linear-gradient(135deg,#0d6e3d 0%,#1a6b3c 60%,#2ecc71 100%); color:#fff;">
        <div class="position-absolute top-0 end-0 opacity-10 d-none d-md-block" style="font-size:14rem; line-height:1;">🦟</div>
        <span class="badge bg-warning text-dark mb-3 px-3 py-2 fw-semibold">
            <i class="bi bi-book-half me-1"></i>@(isBn ? "শিক্ষা কেন্দ্র" : "Learning Center")
        </span>
        <h1 class="fw-bold display-6 mb-2">@(isBn ? "ডেঙ্গু জানুন। সময়মতো সুরক্ষিত হন।" : "Know Dengue. Act Early.")</h1>
        <p class="lead mb-0 opacity-90">@(isBn ? "বাংলাদেশের পরিবারের জন্য ব্যবহারিক তথ্য: প্রতিরোধ, উপসর্গ, সতর্কতা চিহ্ন এবং কখন সেবা নেবেন।" : "Practical information for families in Bangladesh: prevention, symptoms, warning signs, and when to seek care.")</p>
    </div>

    <!-- Articles -->
    <div class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h4 fw-bold mb-0"><i class="bi bi-newspaper me-2 text-success"></i>@(isBn ? "স্বাস্থ্য নিবন্ধ" : "Health Articles")</h2>
        </div>
        @if (Model.Any())
        {
            <div class="row g-4">
                @foreach (var article in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm rounded-4" style="transition: transform .2s;"
                             onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                            <div class="card-body p-4">
                                <span class="badge text-bg-success-subtle text-success mb-2 px-3">
                                    <i class="bi bi-calendar3 me-1"></i>@article.PublishedDate.ToString("dd MMM yyyy")
                                </span>
                                <h3 class="h5 fw-bold mb-2">@article.Title</h3>
                                <p class="text-muted small mb-3">@(article.Content.Length > 120 ? article.Content[..120] + "…" : article.Content)</p>
                                <a asp-action="Article" asp-route-id="@article.Id" class="btn btn-sm btn-outline-success rounded-pill">
                                    @(isBn ? "বিস্তারিত পড়ুন" : "Read more") <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info border-0 rounded-4">
                <i class="bi bi-info-circle me-2"></i>
                @(isBn ? "এই মুহূর্তে কোনো নিবন্ধ নেই। প্রশাসক শীঘ্রই কন্টেন্ট যোগ করবেন।" : "No articles available yet. An administrator will add content soon.")
            </div>

            <!-- Static fallback education cards -->
            <div class="row g-4 mt-1">
                <div class="col-lg-7">
                    <section class="card border-0 shadow-sm h-100 rounded-4">
                        <div class="card-body p-4">
                            <h2 class="h5 fw-bold"><i class="bi bi-shield-check text-success me-2"></i>@(isBn ? "আপনার বাড়ি সুরক্ষিত রাখুন" : "Protect Your Home")</h2>
                            <div class="row g-3 mt-1">
                                <div class="col-sm-6"><h3 class="h6 fw-bold">@(isBn ? "জমা পানি সরান" : "Remove standing water")</h3><p class="small text-muted mb-0">@(isBn ? "বালতি, ফুলের টব, টায়ার, ছাদের নালা সপ্তাহে একবার খালি করুন।" : "Empty buckets, flowerpots, tyres, roof gutters weekly.")</p></div>
                                <div class="col-sm-6"><h3 class="h6 fw-bold">@(isBn ? "মশার কামড় প্রতিরোধ করুন" : "Prevent mosquito bites")</h3><p class="small text-muted mb-0">@(isBn ? "রিপেলেন্ট, লম্বা হাতার পোশাক এবং মশারি ব্যবহার করুন।" : "Use repellent, long sleeves, screens, and a mosquito net.")</p></div>
                                <div class="col-sm-6"><h3 class="h6 fw-bold">@(isBn ? "রোগীর যত্ন নিন" : "Support the sick person")</h3><p class="small text-muted mb-0">@(isBn ? "তরল পানীয় ও বিশ্রামে সাহায্য করুন। চিকিৎসকের পরামর্শ অনুযায়ী প্যারাসিটামল দিন।" : "Encourage appropriate fluids and rest. Use paracetamol as directed.")</p></div>
                                <div class="col-sm-6"><h3 class="h6 fw-bold">@(isBn ? "অনিরাপদ ওষুধ এড়িয়ে চলুন" : "Avoid unsafe medicines")</h3><p class="small text-muted mb-0">@(isBn ? "চিকিৎসকের পরামর্শ ছাড়া অ্যাসপিরিন বা আইবুপ্রোফেন ব্যবহার করবেন না।" : "Avoid aspirin and ibuprofen unless a clinician advises them.")</p></div>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="col-lg-5">
                    <section class="card border-danger h-100 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <h2 class="h5 fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>@(isBn ? "সতর্কতা চিহ্ন" : "Warning Signs")</h2>
                            <p class="small">@(isBn ? "জ্বর কমার সময় (৩-৭ দিন) সতর্কতা চিহ্ন দেখা দিতে পারে। এই লক্ষণগুলোতে দ্রুত চিকিৎসা নিন:" : "Warning signs can appear around days 3–7. Seek urgent medical care for:")</p>
                            <ul class="small mb-0">
                                <li>@(isBn ? "তীব্র পেটব্যথা বা বারবার বমি" : "Severe abdominal pain or repeated vomiting")</li>
                                <li>@(isBn ? "নাক, মাড়ি, বমি বা মলে রক্ত" : "Bleeding from the nose, gums, vomit, or stool")</li>
                                <li>@(isBn ? "চরম দুর্বলতা, অস্থিরতা বা ঘুমঘুম ভাব" : "Extreme weakness, restlessness, or drowsiness")</li>
                                <li>@(isBn ? "দ্রুত শ্বাস-প্রশ্বাস, ফ্যাকাশে বা ঠান্ডা ত্বক" : "Rapid breathing, pale/cold skin, or little urine")</li>
                            </ul>
                            <div class="alert alert-danger mt-3 mb-0 small rounded-3">
                                <strong>@(isBn ? "জরুরি:" : "Emergency:")</strong> @(isBn ? "৯৯৯ নম্বরে ফোন করুন বা নিকটতম হাসপাতালে যান।" : "Call 999 or go to the nearest hospital.")
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        }
    </div>

    <!-- Quizzes -->
    <div class="mb-4">
        <h2 class="h4 fw-bold mb-3"><i class="bi bi-patch-question me-2 text-warning"></i>@(isBn ? "আপনার জ্ঞান যাচাই করুন" : "Test Your Knowledge")</h2>
        @if (quizzes.Any())
        {
            <div class="row g-3">
                @foreach (var quiz in quizzes)
                {
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100" style="background:linear-gradient(135deg,#fffde7,#fff9c4)">
                            <div class="card-body p-4">
                                <i class="bi bi-trophy-fill text-warning fs-2 mb-2 d-block"></i>
                                <h3 class="h5 fw-bold">@quiz.Title</h3>
                                <p class="small text-muted">@quiz.Questions.Count @(isBn ? "টি প্রশ্ন" : "questions")</p>
                                <a asp-action="Quiz" asp-route-id="@quiz.Id" class="btn btn-warning btn-sm rounded-pill fw-semibold">
                                    @(isBn ? "কুইজ শুরু করুন" : "Start Quiz") <i class="bi bi-play-circle ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning border-0 rounded-4">
                <i class="bi bi-info-circle me-2"></i>@(isBn ? "এই মুহূর্তে কোনো কুইজ পাওয়া যাচ্ছে না।" : "No quizzes available at the moment.")
            </div>
        }
    </div>
    <p class="small text-muted"><i class="bi bi-info-circle me-1"></i>@(isBn ? "এই শিক্ষামূলক পাতা কোনো যোগ্য স্বাস্থ্যসেবা পেশাদারের পরামর্শের বিকল্প নয়।" : "This education page supports, but never replaces, advice from a qualified healthcare professional.")</p>
</div>