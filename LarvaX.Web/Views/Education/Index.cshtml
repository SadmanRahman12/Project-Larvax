@model LarvaX.Web.Controllers.DengueQuizViewModel
@{
    ViewData["Title"] = "Dengue Education";
}

<div class="container py-4">
    <div class="rounded-3 bg-success-subtle p-4 p-md-5 mb-4 border-start border-success border-4">
        <span class="badge text-bg-success mb-3"><i class="bi bi-book-half me-1"></i>Dengue learning portal</span>
        <h1 class="fw-bold mb-2">Know dengue. Act early.</h1>
        <p class="lead mb-0">Practical information for families in Bangladesh: prevention, symptoms, warning signs, and when to seek care.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-lg-7">
            <section class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h2 class="h4 fw-bold"><i class="bi bi-shield-check text-success me-2"></i>Protect your home</h2>
                    <div class="row g-3 mt-1">
                        <div class="col-sm-6"><h3 class="h6 fw-bold">Remove standing water</h3><p class="small text-muted mb-0">Empty buckets, flowerpots, tyres, roof gutters, and containers at least once a week.</p></div>
                        <div class="col-sm-6"><h3 class="h6 fw-bold">Prevent mosquito bites</h3><p class="small text-muted mb-0">Use repellent, long sleeves, screens, and a mosquito net, especially during daylight hours.</p></div>
                        <div class="col-sm-6"><h3 class="h6 fw-bold">Support the sick person</h3><p class="small text-muted mb-0">Encourage appropriate fluids and rest. Use paracetamol only as directed by a clinician.</p></div>
                        <div class="col-sm-6"><h3 class="h6 fw-bold">Avoid unsafe medicines</h3><p class="small text-muted mb-0">Avoid aspirin and ibuprofen unless a qualified clinician specifically advises them.</p></div>
                    </div>
                </div>
            </section>
        </div>
        <div class="col-lg-5">
            <section class="card border-danger h-100 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Warning signs</h2>
                    <p class="small">Warning signs can appear as fever improves, often around days 3–7. Seek urgent medical care for:</p>
                    <ul class="small mb-0">
                        <li>Severe abdominal pain or repeated vomiting</li>
                        <li>Bleeding from the nose, gums, vomit, or stool</li>
                        <li>Extreme weakness, restlessness, or drowsiness</li>
                        <li>Rapid breathing, pale/cold skin, or little urine</li>
                    </ul>
                    <div class="alert alert-danger mt-3 mb-0 small"><strong>Emergency:</strong> call 999 or go to the nearest hospital.</div>
                </div>
            </section>
        </div>
    </div>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                <div><h2 class="h3 fw-bold mb-1">Test your dengue knowledge</h2><p class="text-muted mb-0">Choose one answer for each question.</p></div>
                @if (Model.Answered)
                {
                    <span class="badge @(Model.Score >= 3 ? "text-bg-success" : "text-bg-warning") fs-6">@Model.Score / 4 correct</span>
                }
            </div>
            <form method="post">
                @Html.AntiForgeryToken()
                <fieldset class="mb-4"><legend class="h6 fw-bold">1. Which mosquito mainly spreads dengue?</legend><div class="row g-2"><div class="col-md-4"><input class="btn-check" type="radio" asp-for="QuestionOne" value="A" id="q1a"><label class="btn btn-outline-secondary w-100 text-start" for="q1a">A. Aedes mosquito</label></div><div class="col-md-4"><input class="btn-check" type="radio" asp-for="QuestionOne" value="B" id="q1b"><label class="btn btn-outline-secondary w-100 text-start" for="q1b">B. Housefly</label></div><div class="col-md-4"><input class="btn-check" type="radio" asp-for="QuestionOne" value="C" id="q1c"><label class="btn btn-outline-secondary w-100 text-start" for="q1c">C. Tick</label></div></div></fieldset>
                <fieldset class="mb-4"><legend class="h6 fw-bold">2. When do Aedes mosquitoes commonly bite?</legend><div class="row g-2"><div class="col-md-4"><input class="btn-check" type="radio" asp-for="QuestionTwo" value="A" id="q2a"><label class="btn btn-outline-secondary w-100 text-start" for="q2a">A. Only at midnight</label></div><div class="col-md-4"><input class="btn-check" type="radio" asp-for="QuestionTwo" value="B" id="q2b"><label class="btn btn-outline-secondary w-100 text-start" for="q2b">B. Daylight hours</label></div><div class="col-md-4"><input class="btn-check" type="radio" asp-for="QuestionTwo" value="C" id="q2c"><label class="btn btn-outline-secondary w-100 text-start" for="q2c">C. Only in winter</label></div></div></fieldset>
                <fieldset class="mb-4"><legend class="h6 fw-bold">3. Which medicine should generally be avoided in suspected dengue?</legend><div class="row g-2"><div class="col-md-4"><input class="btn-check" type="radio" asp-for="QuestionThree" value="A" id="q3a"><label class="btn btn-outline-secondary w-100 text-start" for="q3a">A. Oral rehydration solution</label></div><div class="col-md-4"><input class="btn-check" type="radio" asp-for="QuestionThree" value="B" id="q3b"><label class="btn btn-outline-secondary w-100 text-start" for="q3b">B. Paracetamol</label></div><div class="col-md-4"><input class="btn-check" type="radio" asp-for="QuestionThree" value="C" id="q3c"><label class="btn btn-outline-secondary w-100 text-start" for="q3c">C. Aspirin or ibuprofen</label></div></div></fieldset>
                <fieldset class="mb-4"><legend class="h6 fw-bold">4. What should you do with standing water around your home?</legend><div class="row g-2"><div class="col-md-4"><input class="btn-check" type="radio" asp-for="QuestionFour" value="A" id="q4a"><label class="btn btn-outline-secondary w-100 text-start" for="q4a">A. Empty and scrub containers weekly</label></div><div class="col-md-4"><input class="btn-check" type="radio" asp-for="QuestionFour" value="B" id="q4b"><label class="btn btn-outline-secondary w-100 text-start" for="q4b">B. Leave it covered with cloth</label></div><div class="col-md-4"><input class="btn-check" type="radio" asp-for="QuestionFour" value="C" id="q4c"><label class="btn btn-outline-secondary w-100 text-start" for="q4c">C. Add more water</label></div></div></fieldset>
                <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>Check answers</button>
            </form>
            @if (Model.Answered)
            {
                <div class="alert alert-info mt-4 mb-0"><strong>Remember:</strong> a quiz cannot diagnose dengue. Fever or warning signs should be assessed by a healthcare professional.</div>
            }
        </div>
    </section>
    <p class="small text-muted"><i class="bi bi-info-circle me-1"></i>This education page supports, but never replaces, advice from a qualified healthcare professional.</p>
</div>