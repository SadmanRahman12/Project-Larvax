@model LarvaX.Web.Controllers.LabBookingViewModel

@{
    ViewData["Title"] = "Book Lab Test";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Book @Model.TestName</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Book" method="post">
                        <input type="hidden" asp-for="LabTestId" />
                        
                        <div class="mb-3">
                            <label class="form-label">Test Name</label>
                            <input type="text" class="form-control" value="@Model.TestName" disabled />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Cost (৳)</label>
                            <input type="text" class="form-control" value="@Model.Cost.ToString("N2")" disabled />
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="ScheduledAt" class="form-label">Select Date & Time</label>
                            <input asp-for="ScheduledAt" type="datetime-local" class="form-control" required />
                            <span asp-validation-for="ScheduledAt" class="text-danger"></span>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Confirm Booking</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
