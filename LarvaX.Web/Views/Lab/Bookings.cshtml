@model IEnumerable<LarvaX.Core.Entities.LabBooking>

@{
    ViewData["Title"] = "My Lab Bookings";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Lab Bookings</h2>
        <a asp-action="Index" class="btn btn-primary">Book New Test</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">You have no lab bookings yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover border">
                <thead class="table-light">
                    <tr>
                        <th>Date & Time</th>
                        <th>Test Name</th>
                        <th>Status</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td>@booking.ScheduledAt.ToLocalTime().ToString("g")</td>
                            <td>@booking.LabTest?.Name</td>
                            <td>
                                @if (booking.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (booking.Status == "SampleCollected")
                                {
                                    <span class="badge bg-info text-dark">Sample Collected</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(booking.ResultLink))
                                {
                                    <a href="@booking.ResultLink" target="_blank" class="btn btn-sm btn-outline-primary">View Result</a>
                                }
                                else
                                {
                                    <span class="text-muted">Not available yet</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
