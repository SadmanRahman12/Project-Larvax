@{
    ViewData["Title"] = "Account Rejected";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm text-center p-4">
                <div class="mb-3">
                    <i class="bi bi-x-circle-fill text-danger" style="font-size: 3.5rem;"></i>
                </div>
                <h2 class="fw-bold mb-2">Account Registration Rejected</h2>
                <p class="text-muted mb-3">
                    Your professional account application has been reviewed and was not approved by the LarvaX administration team.
                </p>
                @if (ViewBag.RejectionReason != null)
                {
                    <div class="alert alert-danger text-start">
                        <strong>Reason provided:</strong><br />
                        @ViewBag.RejectionReason
                    </div>
                }
                <p class="text-muted small">
                    If you believe this is an error, please contact the health authority at
                    <a href="mailto:admin@larvax.gov.bd">admin@larvax.gov.bd</a>.
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary mt-2">
                    <i class="bi bi-house me-1"></i> Return to Home
                </a>
            </div>
        </div>
    </div>
</div>
