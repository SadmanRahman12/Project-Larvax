@{
    ViewData["Title"] = "Account Pending Approval - LarvaX";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 p-4">
            <div class="card-body">
                <div class="mb-3 text-warning">
                    <i class="bi bi-clock-history display-1"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Account Pending Verification</h3>
                <p class="text-muted mb-4">
                    Your professional role registration has been received and is currently under review by the health administration.
                    Once approved, you will be able to log in to access the professional console and tools.
                </p>
                <div class="alert alert-light border text-start">
                    <h6 class="fw-bold text-secondary mb-1"><i class="bi bi-info-circle me-1"></i> What happens next?</h6>
                    <ul class="text-muted small mb-0 ps-3">
                        <li>An Administrator will review your credentials and verify your role.</li>
                        <li>You will be notified once access has been activated.</li>
                    </ul>
                </div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary mt-2">Return to Home</a>
            </div>
        </div>
    </div>
</div>
