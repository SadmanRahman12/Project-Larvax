@model LarvaX.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register - LarvaX";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white text-center py-3 rounded-top-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Create LarvaX Account</h4>
                <small class="text-white-50">Join the Dengue Surveillance & Health Network</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Dr. Rafiqul Islam or Ayesha Rahman" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email / Phone</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-semibold">Role</label>
                        <select asp-for="Role" class="form-select" required>
                            <option value="Citizen">Citizen (Instant Access)</option>
                            <option value="Doctor">Doctor (Requires Admin Approval)</option>
                            <option value="HealthWorker">Health Worker (Requires Admin Approval)</option>
                            <option value="LabStaff">Lab Staff (Requires Admin Approval)</option>
                            <option value="Administrator">Administrator (Requires Approval)</option>
                            <option value="GovernmentAuthority">Government Health Authority (Requires Approval)</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                        <div class="form-text text-muted">
                            <i class="bi bi-info-circle me-1"></i>Professional roles require administrative review before logging in.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PreferredLanguage" class="form-label fw-semibold">Preferred Language / ভাষা</label>
                        <select asp-for="PreferredLanguage" class="form-select">
                            <option value="en">English</option>
                            <option value="bn">বাংলা (Bangla)</option>
                        </select>
                    </div>

                    <div class="mb-3" id="specialtyContainer" style="display: none;">
                        <label asp-for="Specialty" class="form-label fw-semibold">Specialty (For Doctors)</label>
                        <input asp-for="Specialty" class="form-control" placeholder="e.g. Cardiologist, General Physician" />
                        <span asp-validation-for="Specialty" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Complete Registration</button>
                </form>

                <div class="text-center mt-3">
                    <p class="text-muted small mb-0">Already have an account? <a asp-action="Login" class="text-primary text-decoration-none fw-semibold">Log in here</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var roleSelect = document.getElementById("Role");
            var specialtyContainer = document.getElementById("specialtyContainer");

            function toggleSpecialty() {
                if (roleSelect.value === "Doctor") {
                    specialtyContainer.style.display = "block";
                } else {
                    specialtyContainer.style.display = "none";
                }
            }

            roleSelect.addEventListener("change", toggleSpecialty);
            toggleSpecialty(); // initial check
        });
    </script>
}
