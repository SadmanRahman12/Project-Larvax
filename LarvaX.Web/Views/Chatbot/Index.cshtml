@{
    ViewData["Title"] = "DenAI — Dengue Health Assistant - LarvaX";
    var initialQuery = ViewBag.InitialQuery as string ?? "";
    var initialContext = ViewBag.Context as string ?? "";
    var riskLevel = ViewBag.RiskLevel as string ?? "";
    var currentLang = ViewBag.CurrentLang as string ?? "en";
}

<div class="container-fluid px-lg-4 py-3">
    <!-- Breadcrumb & Title Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Health Tools</a></li>
                    <li class="breadcrumb-item active" aria-current="page">DenAI Health Assistant</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <span>🤖 DenAI — Dengue Health Assistant</span>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fs-7 fw-normal px-2 py-1">
                    <span class="spinner-grow spinner-grow-sm text-success me-1" style="width: 8px; height: 8px;" role="status"></span> Active Navigator
                </span>
            </h4>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="small text-muted d-none d-sm-inline">Language / ভাষা:</span>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" id="btnLangEn" class="btn btn-primary" onclick="setLanguage('en')">English</button>
                <button type="button" id="btnLangBn" class="btn btn-outline-primary" onclick="setLanguage('bn')">বাংলা</button>
            </div>
            <button class="btn btn-sm btn-outline-secondary" onclick="resetChat()" title="Start New Conversation">
                <i class="bi bi-arrow-clockwise me-1"></i>Reset
            </button>
        </div>
    </div>

    <!-- Main Grid -->
    <div class="row g-3">
        <!-- Chat Area (Left/Main Column) -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden d-flex flex-column" style="min-height: 680px; height: calc(100vh - 200px);">
                
                <!-- Chat Header -->
                <div class="card-header py-3 px-4 text-white" style="background: linear-gradient(135deg, #0d3b66 0%, #1e5f74 50%, #1d2d44 100%);">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="position-relative">
                                <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px; font-size: 1.4rem;">
                                    🤖
                                </div>
                                <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle p-1"></span>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">DenAI Health Companion</h6>
                                <small class="text-white-50">Bilingual Dengue Triage, First-Aid Guidance & Service Routing</small>
                            </div>
                        </div>
                        <span class="badge bg-white text-dark small px-3 py-2 rounded-pill shadow-sm d-none d-md-inline-block">
                            <i class="bi bi-cpu text-primary me-1"></i>Powered by ML.NET &middot; No API Key
                        </span>
                    </div>
                </div>

                <!-- Emergency Banner (Hidden by default) -->
                <div id="emergencyBanner" class="d-none alert alert-danger border-0 rounded-0 m-0 py-2 px-3 shadow-sm">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-octagon-fill fs-4 text-danger animate-pulse"></i>
                            <div>
                                <strong id="emergencyMsg" class="d-block text-danger">⚠️ Medical Alert</strong>
                                <small class="text-muted">High-risk warning signs detected. Immediate action required.</small>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="tel:999" class="btn btn-danger btn-sm px-3 fw-bold shadow-sm">
                                <i class="bi bi-telephone-fill me-1"></i>Call 999
                            </a>
                            <a href="/FirstAid" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-heart-pulse-fill me-1"></i>First Aid
                            </a>
                            <a href="/IcuBeds" class="btn btn-outline-dark btn-sm">
                                <i class="bi bi-hospital me-1"></i>Find ICU
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Chat Messages Stream -->
                <div id="chatMessages" class="p-4 flex-grow-1 overflow-auto" style="background: #f8fafc;">
                    
                    <!-- Welcome Bot Bubble -->
                    <div class="d-flex gap-3 mb-4 message-row bot-row">
                        <div class="flex-shrink-0">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;">
                                🤖
                            </div>
                        </div>
                        <div class="card border-0 shadow-sm rounded-4 p-3" style="max-width: 85%; background: #ffffff;">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-bold text-primary small">DenAI</span>
                                <span class="text-muted" style="font-size: 0.72rem;">Just now</span>
                            </div>
                            <p class="mb-2 text-dark small lh-base" id="welcomeTextEn">
                                Hello! I'm <strong>DenAI</strong>, your conversational dengue health assistant. I can answer questions about dengue symptoms, guide you through emergency warning signs, provide fever care steps, and route you directly to verified doctors, labs, blood donors, or ICU beds.
                            </p>
                            <p class="mb-3 text-secondary small lh-base" id="welcomeTextBn">
                                <em>নমস্কার! আমি <strong>DenAI</strong>, আপনার ডেঙ্গু স্বাস্থ্য সহকারী। ডেঙ্গুর উপসর্গ, বিপদের লক্ষণ, ঘরোয়া যত্ন, ল্যাব পরীক্ষা, ডাক্তার পরামর্শ বা রক্তদাতার সন্ধানে যে কোনো প্রশ্ন করুন।</em>
                            </p>

                            <!-- Welcome Quick Action Buttons -->
                            <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                                <a href="/SymptomChecker" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-clipboard2-pulse me-1"></i>Symptom Assessment
                                </a>
                                <a href="/FirstAid/Guide?type=dengue" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="bi bi-heart-pulse me-1"></i>Warning Signs
                                </a>
                                <a href="/Donors" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="bi bi-droplet-fill me-1"></i>Blood Donors
                                </a>
                                <a href="/Telemedicine" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-camera-video me-1"></i>Consult Doctor
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Typing Indicator (Hidden by default) -->
                    <div id="typingIndicator" class="d-none d-flex gap-3 mb-3">
                        <div class="flex-shrink-0">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px;">
                                🤖
                            </div>
                        </div>
                        <div class="card border-0 shadow-sm rounded-4 px-3 py-2 bg-white d-inline-flex align-items-center">
                            <div class="typing-dots">
                                <span></span><span></span><span></span>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Suggested Questions Bar -->
                <div class="bg-light px-3 py-2 border-top border-bottom">
                    <div class="d-flex align-items-center gap-2 overflow-auto text-nowrap pb-1" id="suggestionsContainer">
                        <small class="text-muted fw-semibold flex-shrink-0"><i class="bi bi-lightbulb me-1 text-warning"></i>Suggested:</small>
                        <button class="btn btn-sm btn-white border rounded-pill px-3 shadow-2xs suggestion-chip" onclick="quickAsk('What are the warning signs of dengue?')">Warning Signs</button>
                        <button class="btn btn-sm btn-white border rounded-pill px-3 shadow-2xs suggestion-chip" onclick="quickAsk('I have fever for 3 days')">Fever Help</button>
                        <button class="btn btn-sm btn-white border rounded-pill px-3 shadow-2xs suggestion-chip" onclick="quickAsk('Where can I get a dengue lab test?')">Lab Test</button>
                        <button class="btn btn-sm btn-white border rounded-pill px-3 shadow-2xs suggestion-chip" onclick="quickAsk('I need blood or platelet donor')">Blood Donors</button>
                        <button class="btn btn-sm btn-white border rounded-pill px-3 shadow-2xs suggestion-chip" onclick="quickAsk('How to prevent dengue at home?')">Prevention</button>
                    </div>
                </div>

                <!-- Input Footer -->
                <div class="card-footer bg-white p-3">
                    <form id="chatForm" onsubmit="event.preventDefault(); sendMessage();" class="d-flex gap-2">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-chat-quote"></i>
                            </span>
                            <input id="chatInput" type="text" class="form-control border-start-0 ps-1" 
                                   placeholder="Ask DenAI about symptoms, fever care, tests, or doctors..." 
                                   autocomplete="off" maxlength="400" />
                        </div>
                        <button id="sendBtn" type="submit" class="btn btn-primary px-4 d-flex align-items-center gap-1 shadow-sm">
                            <span>Send</span>
                            <i class="bi bi-send-fill ms-1"></i>
                        </button>
                    </form>
                    <div class="d-flex align-items-center justify-content-between mt-2 pt-1 px-1">
                        <small class="text-muted" style="font-size: 0.75rem;">
                            <i class="bi bi-info-circle me-1"></i><strong>Medical Disclaimer:</strong> DenAI provides health triage & guidance, not clinical diagnosis.
                        </small>
                        <small class="text-muted" style="font-size: 0.75rem;">
                            Press <kbd class="bg-light text-dark border">Enter</kbd> to send
                        </small>
                    </div>
                </div>

            </div>
        </div>

        <!-- Sidebar Navigation & Quick Tools (Right Column) -->
        <div class="col-lg-4">
            <!-- Platform Routing & Quick Services Card -->
            <div class="card shadow-sm border-0 rounded-3 mb-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-grid-fill text-primary"></i>
                        <span>Platform Healthcare Routing</span>
                    </h6>
                    <small class="text-muted">Dedicated modules connected to DenAI</small>
                </div>
                <div class="list-group list-group-flush rounded-bottom-3 small">
                    <a asp-controller="SymptomChecker" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-danger-subtle text-danger p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-clipboard2-pulse"></i>
                            </div>
                            <div>
                                <span class="fw-semibold text-dark d-block">Symptom Checker</span>
                                <small class="text-muted">Structured assessment & risk classification</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <a asp-controller="FirstAid" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-danger-subtle text-danger p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-heart-pulse-fill"></i>
                            </div>
                            <div>
                                <span class="fw-semibold text-dark d-block">First Aid AI & Guide</span>
                                <small class="text-muted">Emergency protocol, fainting & shock steps</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <a asp-controller="Telemedicine" asp-action="Doctors" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-camera-video"></i>
                            </div>
                            <div>
                                <span class="fw-semibold text-dark d-block">Doctor Consultation</span>
                                <small class="text-muted">Telemedicine video appointments & doctors</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <a asp-controller="Lab" asp-action="Book" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-info-subtle text-info p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-droplet-half"></i>
                            </div>
                            <div>
                                <span class="fw-semibold text-dark d-block">Dengue Lab Tests</span>
                                <small class="text-muted">NS1 antigen, IgM/IgG & CBC blood booking</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <a asp-controller="Donors" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-danger-subtle text-danger p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-droplet-fill"></i>
                            </div>
                            <div>
                                <span class="fw-semibold text-dark d-block">Blood & Platelet Donors</span>
                                <small class="text-muted">Real-time active donor directory</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <a asp-controller="IcuBeds" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-dark-subtle text-dark p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-hospital"></i>
                            </div>
                            <div>
                                <span class="fw-semibold text-dark d-block">ICU Bed Finder</span>
                                <small class="text-muted">Live hospital bed availability</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <a asp-controller="FluidManagement" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-warning-subtle text-warning p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-calculator"></i>
                            </div>
                            <div>
                                <span class="fw-semibold text-dark d-block">IV Fluid & Hydration</span>
                                <small class="text-muted">Maintenance fluid & hydration calculator</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <a asp-controller="Education" asp-action="Quiz" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-success-subtle text-success p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-patch-question"></i>
                            </div>
                            <div>
                                <span class="fw-semibold text-dark d-block">Dengue Quizzes & Myths</span>
                                <small class="text-muted">Interactive community awareness</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                </div>
            </div>

            <!-- Dengue Quick Guidance Card -->
            <div class="card shadow-sm border-0 rounded-3 bg-light">
                <div class="card-body p-3">
                    <h6 class="fw-bold text-dark mb-2">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                        Clinical Safety Rules
                    </h6>
                    <ul class="list-unstyled mb-0 small text-secondary">
                        <li class="mb-2 d-flex gap-2">
                            <i class="bi bi-x-circle text-danger mt-1"></i>
                            <span><strong>No Aspirin / NSAIDs:</strong> Avoid aspirin or ibuprofen as they trigger bleeding complications. Use Paracetamol.</span>
                        </li>
                        <li class="mb-2 d-flex gap-2">
                            <i class="bi bi-check-circle text-success mt-1"></i>
                            <span><strong>Hydration is Key:</strong> Continually sip ORS, coconut water, or clear broth to prevent plasma leakage shock.</span>
                        </li>
                        <li class="d-flex gap-2">
                            <i class="bi bi-telephone-outbound text-primary mt-1"></i>
                            <span><strong>Emergency Contact:</strong> Call <strong>999</strong> immediately if you observe persistent vomiting, bleeding, or extreme lethargy.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .message-row {
        animation: fadeIn 0.3s ease-in-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .typing-dots span {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background-color: #0d6efd;
        margin: 0 2px;
        animation: dotPulse 1.4s infinite ease-in-out both;
    }
    .typing-dots span:nth-child(1) { animation-delay: -0.32s; }
    .typing-dots span:nth-child(2) { animation-delay: -0.16s; }
    @@keyframes dotPulse {
        0%, 80%, 100% { transform: scale(0); opacity: 0.4; }
        40% { transform: scale(1); opacity: 1; }
    }
    .suggestion-chip {
        font-size: 0.8rem;
        transition: all 0.2s ease;
    }
    .suggestion-chip:hover {
        background-color: #e9ecef;
        transform: translateY(-1px);
    }
    .animate-pulse {
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.15); }
        100% { transform: scale(1); }
    }
</style>

@section Scripts {
<script>
    let currentLanguage = '@currentLang' || 'en';
    let currentContextState = null;

    function setLanguage(lang) {
        currentLanguage = lang;
        const btnEn = document.getElementById('btnLangEn');
        const btnBn = document.getElementById('btnLangBn');
        const input = document.getElementById('chatInput');

        if (lang === 'bn') {
            btnBn.className = 'btn btn-primary';
            btnEn.className = 'btn btn-outline-primary';
            input.placeholder = "উপসর্গ, জ্বর, টেস্ট, রক্তদাতা বা ডাক্তার সম্পর্কে প্রশ্ন করুন...";
            updateDefaultSuggestions('bn');
        } else {
            btnEn.className = 'btn btn-primary';
            btnBn.className = 'btn btn-outline-primary';
            input.placeholder = "Ask DenAI about symptoms, fever care, tests, or doctors...";
            updateDefaultSuggestions('en');
        }
    }

    function updateDefaultSuggestions(lang) {
        const container = document.getElementById('suggestionsContainer');
        const isBn = lang === 'bn';
        const suggestions = isBn ? [
            { text: "ডেঙ্গুর বিপদের লক্ষণগুলো কী?", label: "বিপদের লক্ষণ" },
            { text: "আমার ৩ দিন ধরে জ্বর", label: "জ্বর পরামর্শ" },
            { text: "ডেঙ্গু টেস্ট কোথায় করব?", label: "ল্যাব টেস্ট" },
            { text: "রক্ত বা প্লেটলেট দরকার", label: "রক্তদাতা" },
            { text: "বাসায় ডেঙ্গু প্রতিরোধ করব কীভাবে?", label: "প্রতিরোধ" }
        ] : [
            { text: "What are the warning signs of dengue?", label: "Warning Signs" },
            { text: "I have fever for 3 days", label: "Fever Help" },
            { text: "Where can I get a dengue lab test?", label: "Lab Test" },
            { text: "I need blood or platelet donor", label: "Blood Donors" },
            { text: "How to prevent dengue at home?", label: "Prevention" }
        ];

        let html = '<small class="text-muted fw-semibold flex-shrink-0"><i class="bi bi-lightbulb me-1 text-warning"></i>' +
                   (isBn ? 'পরামর্শ:' : 'Suggested:') + '</small>';

        suggestions.forEach(s => {
            html += `<button class="btn btn-sm btn-white border rounded-pill px-3 shadow-2xs suggestion-chip" onclick="quickAsk('${escapeHtml(s.text)}')">${escapeHtml(s.label)}</button>`;
        });
        container.innerHTML = html;
    }

    function appendMessage(text, fromBot, isEmergency = false, actionButtons = null, mlConfidence = 0, modelSource = 'ML') {
        const box = document.getElementById('chatMessages');
        const row = document.createElement('div');
        row.className = 'd-flex gap-3 mb-4 message-row ' + (fromBot ? 'bot-row' : 'justify-content-end user-row');

        const now = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        if (fromBot) {
            let actionsHtml = '';
            if (actionButtons && actionButtons.length > 0) {
                actionsHtml = '<div class="d-flex flex-wrap gap-2 pt-2 mt-2 border-top">';
                actionButtons.forEach(btn => {
                    const btnClass = btn.buttonClass || 'btn-outline-primary';
                    const icon = btn.icon ? `<i class="bi ${escapeHtml(btn.icon)} me-1"></i>` : '';
                    actionsHtml += `<a href="${escapeHtml(btn.url)}" class="btn btn-sm ${escapeHtml(btnClass)} rounded-pill px-3 shadow-2xs">${icon}${escapeHtml(btn.label)}</a>`;
                });
                actionsHtml += '</div>';
            }

            // ML Confidence badge
            let mlBadge = '';
            if (modelSource) {
                const isSafety = modelSource === 'Safety';
                const pct = mlConfidence > 0 ? Math.round(mlConfidence * 100) : null;
                const badgeColor = isSafety ? 'bg-danger-subtle text-danger' : (pct && pct >= 75 ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary');
                const badgeIcon = isSafety ? 'bi-shield-exclamation' : 'bi-cpu';
                const badgeText = isSafety
                    ? '<i class="bi bi-shield-exclamation me-1"></i>Safety Override'
                    : (pct ? `<i class="bi bi-cpu me-1"></i>ML · ${pct}%` : '<i class="bi bi-cpu me-1"></i>ML.NET');
                mlBadge = `<span class="badge rounded-pill ${badgeColor} ms-1" style="font-size:0.65rem;">${badgeText}</span>`;
            }

            const alertBorder = isEmergency ? 'border border-danger border-2' : 'border-0';
            const alertBg = isEmergency ? '#fff5f5' : '#ffffff';

            row.innerHTML = `
                <div class="flex-shrink-0">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;">
                        🤖
                    </div>
                </div>
                <div class="card ${alertBorder} shadow-sm rounded-4 p-3" style="max-width: 85%; background: ${alertBg};">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="fw-bold ${isEmergency ? 'text-danger' : 'text-primary'} small">DenAI ${mlBadge}</span>
                        <span class="text-muted" style="font-size: 0.72rem;">${now}</span>
                    </div>
                    <div class="small text-dark lh-base" style="white-space: pre-line;">${formatText(text)}</div>
                    ${actionsHtml}
                </div>
            `;
        } else {
            row.innerHTML = `
                <div class="card border-0 shadow-sm rounded-4 p-3 text-white" style="max-width: 80%; background: linear-gradient(135deg, #0d6efd, #0b5ed7);">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="fw-bold small opacity-75">You</span>
                        <span class="opacity-75" style="font-size: 0.72rem;">${now}</span>
                    </div>
                    <div class="small text-white lh-base">${escapeHtml(text)}</div>
                </div>
                <div class="flex-shrink-0">
                    <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                </div>
            `;
        }

        // Insert before typing indicator
        const typingEl = document.getElementById('typingIndicator');
        box.insertBefore(row, typingEl);
        box.scrollTop = box.scrollHeight;
    }

    function showEmergencyBanner(msg) {
        const banner = document.getElementById('emergencyBanner');
        document.getElementById('emergencyMsg').innerText = msg;
        banner.classList.remove('d-none');
    }

    function setTyping(isTyping) {
        const el = document.getElementById('typingIndicator');
        if (isTyping) {
            el.classList.remove('d-none');
        } else {
            el.classList.add('d-none');
        }
        const box = document.getElementById('chatMessages');
        box.scrollTop = box.scrollHeight;
    }

    async function sendMessage(overrideText) {
        const input = document.getElementById('chatInput');
        const msg = (overrideText || input.value).trim();
        if (!msg) return;

        appendMessage(msg, false);
        if (!overrideText) input.value = '';

        document.getElementById('sendBtn').disabled = true;
        setTyping(true);

        try {
            const res = await fetch('/Chatbot/Reply', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    message: msg, 
                    language: currentLanguage,
                    contextState: currentContextState
                })
            });

            if (!res.ok) throw new Error("HTTP error " + res.status);

            const data = await res.json();
            setTyping(false);

            // Update context state
            currentContextState = data.contextState || null;

            appendMessage(data.reply, true, data.isEmergency, data.actionButtons,
                data.mlConfidence || 0, data.modelSource || 'ML');

            if (data.isEmergency && data.emergencyMessage) {
                showEmergencyBanner(data.emergencyMessage);
            }

            // reply already appended above with ML metadata

            // Update suggestions if provided
            if (data.suggestedQuestions && data.suggestedQuestions.length > 0) {
                updateCustomSuggestions(data.suggestedQuestions);
            }

        } catch (e) {
            setTyping(false);
            appendMessage(currentLanguage === 'bn' 
                ? 'দুঃখিত, সংযোগে সমস্যা হয়েছে। অনুগ্রহ করে আবার চেষ্টা করুন।' 
                : 'I encountered a communication error. Please try again.', true);
        } finally {
            document.getElementById('sendBtn').disabled = false;
            document.getElementById('chatInput').focus();
        }
    }

    function updateCustomSuggestions(questions) {
        const container = document.getElementById('suggestionsContainer');
        const isBn = currentLanguage === 'bn';
        let html = '<small class="text-muted fw-semibold flex-shrink-0"><i class="bi bi-lightbulb me-1 text-warning"></i>' +
                   (isBn ? 'পরামর্শ:' : 'Suggested:') + '</small>';

        questions.forEach(q => {
            html += `<button class="btn btn-sm btn-white border rounded-pill px-3 shadow-2xs suggestion-chip" onclick="quickAsk('${escapeHtml(q)}')">${escapeHtml(q)}</button>`;
        });
        container.innerHTML = html;
    }

    function quickAsk(text) {
        document.getElementById('chatInput').value = text;
        sendMessage();
    }

    function resetChat() {
        currentContextState = null;
        document.getElementById('emergencyBanner').classList.add('d-none');
        const box = document.getElementById('chatMessages');
        // Keep initial bot welcome
        const rows = box.querySelectorAll('.message-row');
        for (let i = 1; i < rows.length; i++) {
            rows[i].remove();
        }
        updateDefaultSuggestions(currentLanguage);
        document.getElementById('chatInput').value = '';
        document.getElementById('chatInput').focus();
    }

    function formatText(str) {
        if (!str) return '';
        // Escape HTML
        let escaped = escapeHtml(str);
        // Bold **text**
        escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        return escaped;
    }

    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.toString().replace(/[&<>"']/g, function(m) { return map[m]; });
    }

    // Auto-run if query or context passed via URL
    document.addEventListener("DOMContentLoaded", function() {
        const initQ = '@Html.Raw(initialQuery)';
        const initContext = '@Html.Raw(initialContext)';
        const risk = '@Html.Raw(riskLevel)';

        if (initQ && initQ.trim().length > 0) {
            sendMessage(initQ);
        } else if (initContext === 'symptom_result') {
            const riskMsg = risk ? `I just completed the Symptom Checker and got a ${risk} risk assessment. What should I do next?` : 'I completed the Symptom Checker. What should I do next?';
            sendMessage(riskMsg);
        }
    });
</script>
}
