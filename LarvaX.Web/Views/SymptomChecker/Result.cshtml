@{
    ViewData["Title"] = "Symptom Result - LarvaX";
    string risk = ViewBag.RiskLevel as string ?? "Low";
    bool isEmergency = ViewBag.IsEmergency == true;
    string bgColor = risk switch {
        "Emergency" => "bg-danger",
        "High" => "bg-warning",
        "Medium" => "bg-info",
        _ => "bg-success"
    };
    string textColor = (risk == "High" || risk == "Emergency") ? "text-white" : "text-dark";
    var warningFlags = ViewBag.WarningFlags as IEnumerable<string> ?? Enumerable.Empty<string>();
}

@if (isEmergency)
{
    <!-- Emergency interrupt screen — always shown BEFORE any other content -->
    <div class="alert alert-danger border-0 rounded-3 shadow p-4 mb-4">
        <div class="d-flex align-items-start gap-3">
            <div class="fs-1"><i class="bi bi-exclamation-octagon-fill"></i></div>
            <div>
                <h4 class="fw-bold mb-1">🚨 Possible Medical Emergency Detected</h4>
                <p class="mb-2">Your symptoms include severe warning signs. Please seek immediate care — do NOT wait.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="tel:999" class="btn btn-light fw-bold"><i class="bi bi-telephone-fill me-1"></i>Call Emergency: 999</a>
                    <a asp-controller="FirstAid" asp-action="Index" class="btn btn-outline-light fw-bold"><i class="bi bi-heart-pulse me-1"></i>First Aid Guide</a>
                </div>
            </div>
        </div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow border-0 rounded-3 overflow-hidden">
            <div class="card-header @bgColor @textColor py-4 text-center">
                <h2 class="fw-bold mb-1 display-6">
                    @if (risk == "Emergency") { <text>🚨</text> }
                    else if (risk == "High") { <text>🔴</text> }
                    else if (risk == "Medium") { <text>🟡</text> }
                    else { <text>🟢</text> }
                    Risk Level: @risk
                </h2>
                <div class="mt-2">
                    @await Component.InvokeAsync("ConfidenceTag", new { note = (string)(ViewBag.ConfidenceNote ?? ""), isEmergency = isEmergency })
                </div>
            </div>
            <div class="card-body p-4">
                <h5 class="fw-semibold"><i class="bi bi-clipboard2-pulse me-2 text-primary"></i>What This Means</h5>
                <p class="text-muted">@ViewBag.Advice</p>

                <div class="row g-3 mb-3 small">
                    <div class="col-sm-6"><div class="border rounded p-3 h-100"><span class="text-muted">Screening score</span><div class="fs-5 fw-bold">@ViewBag.Score</div><span class="text-muted">This is an internal screening score, not a probability or diagnosis.</span></div></div>
                    <div class="col-sm-6"><div class="border rounded p-3 h-100"><span class="text-muted">What to do next</span><div class="fw-bold">Follow the urgency above</div><span class="text-muted">A worsening condition overrides any earlier result.</span></div></div>
                </div>

                @if (warningFlags.Any())
                {
                    <div class="alert alert-warning small" role="alert">
                        <strong><i class="bi bi-exclamation-triangle me-1"></i>Warning flags detected</strong>
                        <ul class="mb-0 mt-2">
                            @foreach (var flag in warningFlags)
                            {
                                <li>@flag</li>
                            }
                        </ul>
                    </div>
                }

                <hr />

                <h6 class="fw-bold text-muted">Recommended Next Steps</h6>
                <ul class="list-unstyled">
                    @if (risk == "Emergency" || risk == "High")
                    {
                        <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-danger me-2"></i>Visit the nearest hospital or emergency clinic immediately.</li>
                        <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-danger me-2"></i>Request an NS1 antigen or PCR dengue blood test.</li>
                        <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-danger me-2"></i>Stay hydrated with ORS fluids.</li>
                    }
                    else if (risk == "Medium")
                    {
                        <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-warning me-2"></i>Monitor temperature every 4 hours.</li>
                        <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-warning me-2"></i>Drink plenty of fluids. Avoid aspirin/ibuprofen.</li>
                        <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-warning me-2"></i>See a doctor if fever continues beyond 48 hours.</li>
                    }
                    else
                    {
                        <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-success me-2"></i>Rest and stay hydrated.</li>
                        <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-success me-2"></i>Avoid mosquito exposure — use repellent.</li>
                        <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-success me-2"></i>Monitor if new symptoms appear.</li>
                    }
                </ul>

                <!-- Premium Family Tracking Callout -->
                <div class="card bg-success-subtle border-success-subtle rounded-3 p-3 my-3">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div>
                            <div class="fw-bold text-success-emphasis small">
                                <i class="bi bi-star-fill text-warning me-1"></i>Premium Feature: Family Health Timeline
                            </div>
                            <small class="text-success-emphasis">
                                Save this assessment, track fever recovery curves, and monitor family dengue trends.
                            </small>
                        </div>
                        <a asp-controller="Subscription" asp-action="MySubscription" class="btn btn-success btn-sm rounded-pill px-3 fw-semibold">
                            Save Assessment
                        </a>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Retake Checker</a>
                    <a asp-controller="Chatbot" asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-chat-dots me-1"></i>Ask DenAI</a>
                    <a asp-controller="FirstAid" asp-action="Index" class="btn btn-outline-danger btn-sm"><i class="bi bi-heart-pulse me-1"></i>First Aid Guide</a>
                </div>

                <div class="alert alert-secondary small mt-4 mb-0" role="alert">
                    <strong>Important limitation:</strong> This result is based only on the symptoms selected. It does not include examination findings, blood tests, pregnancy status, age-related risk, medicines, or other causes of fever. A low-risk result does not rule out dengue or another serious illness. Seek care if symptoms worsen or you are concerned.
                </div>
            </div>
        </div>
    </div>
</div>

<section class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 small">
                <h5 class="fw-bold"><i class="bi bi-journal-medical text-primary me-2"></i>References</h5>
                <p class="text-muted">Educational content is based on public dengue guidance. Recommendations may vary by country and patient condition; clinicians should follow current local protocols.</p>
                <ul class="mb-0">
                    <li><a href="https://www.who.int/publications/i/item/9789241547871" target="_blank" rel="noopener noreferrer">World Health Organization: Dengue guidelines</a></li>
                    <li><a href="https://www.cdc.gov/dengue/signs-symptoms/index.html" target="_blank" rel="noopener noreferrer">CDC: Signs and symptoms of dengue</a></li>
                    <li><a href="https://www.who.int/news-room/fact-sheets/detail/dengue-and-severe-dengue" target="_blank" rel="noopener noreferrer">WHO: Dengue and severe dengue</a></li>
                </ul>
            </div>
        </div>
    </div>
</section>
