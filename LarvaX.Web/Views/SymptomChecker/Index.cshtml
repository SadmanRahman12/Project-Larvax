@{
    ViewData["Title"] = "AI Symptom Checker - LarvaX";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header py-3" style="background: linear-gradient(135deg,#a8034b,#e83e8c);">
                <h4 class="mb-0 fw-bold text-white"><i class="bi bi-heart-pulse-fill me-2"></i>AI Symptom Checker</h4>
                <small class="text-white-50">Answer honestly — this helps us assess your dengue risk. Not a substitute for medical advice.</small>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info d-flex gap-2 align-items-start small" role="alert">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                    <div><strong>What this checks:</strong> This short screen looks for common dengue symptoms and warning signs. It cannot confirm dengue, identify another illness, or measure how quickly a patient may deteriorate.</div>
                </div>

                <div class="row g-3 mb-4 small">
                    <div class="col-sm-4"><div class="border rounded p-3 h-100"><strong><i class="bi bi-thermometer-half text-danger me-1"></i>Symptoms</strong><p class="text-muted mb-0 mt-1">Select symptoms happening now or recently, not symptoms you are only worried about.</p></div></div>
                    <div class="col-sm-4"><div class="border rounded p-3 h-100"><strong><i class="bi bi-clock-history text-primary me-1"></i>Timing</strong><p class="text-muted mb-0 mt-1">Note when fever began and whether symptoms are worsening, especially as fever settles.</p></div></div>
                    <div class="col-sm-4"><div class="border rounded p-3 h-100"><strong><i class="bi bi-person-check text-success me-1"></i>Next step</strong><p class="text-muted mb-0 mt-1">Use the result to decide how urgently to seek professional assessment, never as a diagnosis.</p></div></div>
                </div>

                <form asp-action="Result" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3 p-3 border rounded bg-light">
                        <h6 class="fw-bold mb-3"><i class="bi bi-thermometer-half text-danger me-1"></i>Step 1 of 3 — Current Symptoms</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="Fever" value="true" id="chk_fever" />
                            <label class="form-check-label" for="chk_fever">Sudden high fever (above 38°C / 100.4°F)</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="SeverHeadache" value="true" id="chk_headache" />
                            <label class="form-check-label" for="chk_headache">Severe headache or pain behind the eyes</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="RashBehindEyes" value="true" id="chk_rash" />
                            <label class="form-check-label" for="chk_rash">Skin rash or red spots on body</label>
                        </div>
                    </div>

                    <div class="mb-3 p-3 border rounded bg-light">
                        <h6 class="fw-bold mb-3"><i class="bi bi-activity text-warning me-1"></i>Step 2 of 3 — Pain & Discomfort</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="JointPain" value="true" id="chk_joint" />
                            <label class="form-check-label" for="chk_joint">Severe joint, bone, or muscle pain</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="VomitingNausea" value="true" id="chk_vomit" />
                            <label class="form-check-label" for="chk_vomit">Vomiting or persistent nausea</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="AbdominalPain" value="true" id="chk_abdom" />
                            <label class="form-check-label" for="chk_abdom">Abdominal pain or tenderness</label>
                        </div>
                    </div>

                    <div class="mb-4 p-3 border border-danger rounded bg-danger bg-opacity-10">
                        <h6 class="fw-bold mb-3 text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Step 3 of 3 — Warning Signs (Severe)</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="Bleeding" value="true" id="chk_bleed" />
                            <label class="form-check-label fw-semibold text-danger" for="chk_bleed">Bleeding from nose/gums, blood in urine/stool, or unusual bruising</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 py-2 fw-bold">
                        <i class="bi bi-search me-1"></i>Check My Dengue Risk
                    </button>
                    <p class="text-muted text-center small mt-2">Result includes a confidence rating based on 1,250+ validated cases.</p>
                </form>

                <div class="border-top mt-4 pt-3 small text-muted">
                    <strong class="text-dark">Seek urgent help now</strong> for bleeding, severe abdominal pain, repeated vomiting, breathing difficulty, confusion, fainting, cold or pale skin, or very little urine. Call 999 for a life-threatening emergency.
                </div>
            </div>
        </div>
    </div>
</div>

<section class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 small">
                <h5 class="fw-bold"><i class="bi bi-book text-primary me-2"></i>Learn more</h5>
                <p class="text-muted">For symptoms lasting more than a day, pregnancy, very young or older patients, or existing medical conditions, contact a healthcare professional even if the result is low risk.</p>
                <ul class="mb-0">
                    <li><a href="https://www.who.int/publications/i/item/9789241547871" target="_blank" rel="noopener noreferrer">World Health Organization: Dengue guidelines</a></li>
                    <li><a href="https://www.cdc.gov/dengue/signs-symptoms/index.html" target="_blank" rel="noopener noreferrer">CDC: Signs and symptoms of dengue</a></li>
                    <li><a href="https://www.who.int/news-room/fact-sheets/detail/dengue-and-severe-dengue" target="_blank" rel="noopener noreferrer">WHO: Dengue and severe dengue</a></li>
                </ul>
            </div>
        </div>
    </div>
</section>
