@using LarvaX.Core.Entities
@{
    ViewData["Title"] = "Monetization & Subscriptions - Admin Console";
    var recentTxns = ViewBag.RecentTransactions as List<PaymentTransaction> ?? new();
    var coupons = ViewBag.Coupons as List<Coupon> ?? new();
    var plans = ViewBag.Plans as List<SubscriptionPlan> ?? new();
    decimal totalRevenue = ViewBag.TotalRevenue != null ? (decimal)ViewBag.TotalRevenue : 0m;
    int totalSubs = ViewBag.TotalSubscribers != null ? (int)ViewBag.TotalSubscribers : 0;
    int activePremium = ViewBag.ActivePremium != null ? (int)ViewBag.ActivePremium : 0;
    int activePro = ViewBag.ActivePro != null ? (int)ViewBag.ActivePro : 0;
}

<div class="container-fluid px-4 py-4">
    <partial name="_AdminNav" />

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Admin Console</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Subscriptions & Revenue</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0 text-dark">
                <i class="bi bi-cash-coin text-success me-2"></i>Monetization & Subscription Management
            </h2>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-controller="Subscription" asp-action="Index" target="_blank" class="btn btn-outline-dark rounded-pill px-3">
                <i class="bi bi-eye me-1"></i>View Public Pricing Page
            </a>
            <button class="btn btn-success rounded-pill px-3 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#newCouponModal">
                <i class="bi bi-tag-fill me-1"></i>Create Promo Coupon
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Metrics Row -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">Total Revenue (Gross)</span>
                    <div class="bg-success bg-opacity-10 text-success p-2 rounded-circle">
                        <i class="bi bi-currency-dollar fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">৳@totalRevenue.ToString("N0")</h3>
                <small class="text-success fw-semibold"><i class="bi bi-arrow-up-right me-1"></i>Lifetime collected</small>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">Active Paid Subscribers</span>
                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-circle">
                        <i class="bi bi-people-fill fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@totalSubs</h3>
                <small class="text-muted">Current recurring members</small>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">Citizen Premium</span>
                    <div class="bg-warning bg-opacity-10 text-warning p-2 rounded-circle">
                        <i class="bi bi-star-fill fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@activePremium</h3>
                <small class="text-muted">Families & individuals</small>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">Clinicians & Labs</span>
                    <div class="bg-info bg-opacity-10 text-info p-2 rounded-circle">
                        <i class="bi bi-hospital-fill fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@activePro</h3>
                <small class="text-muted">Professional & Institutional</small>
            </div>
        </div>
    </div>

    <!-- Active Plans & Coupons Row -->
    <div class="row g-4 mb-4">
        <!-- Active Subscription Plans -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h5 class="fw-bold mb-0"><i class="bi bi-layers-fill text-primary me-2"></i>Configured Plans</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="list-group list-group-flush">
                        @foreach (var plan in plans)
                        {
                            <div class="list-group-item px-0 py-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="fw-bold text-dark mb-0">@plan.Name <span class="badge bg-light text-secondary ms-1 small">@plan.Tier</span></h6>
                                    <span class="fw-bold text-success">
                                        @(plan.PriceMonthly == 0 ? "Free" : $"৳{plan.PriceMonthly:N0}/mo · ৳{plan.PriceYearly:N0}/yr")
                                    </span>
                                </div>
                                <p class="text-muted small mb-1">@plan.Description</p>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-light text-dark border small">DenAI: @(plan.DailyDenAiQuota == -1 ? "Unlimited" : $"{plan.DailyDenAiQuota}/day")</span>
                                    <span class="badge bg-light text-dark border small">Family: up to @plan.MaxFamilyMembers members</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Promo Coupons -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-tag-fill text-warning me-2"></i>Promotional Coupons</h5>
                    <button class="btn btn-outline-success btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#newCouponModal">
                        <i class="bi bi-plus me-1"></i>New Coupon
                    </button>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Discount</th>
                                    <th>Uses</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in coupons)
                                {
                                    <tr>
                                        <td><code class="fw-bold text-primary">@c.Code</code></td>
                                        <td class="fw-semibold">@(c.DiscountPercent > 0 ? $"{c.DiscountPercent:N0}%" : $"৳{c.FixedDiscountAmount:N0}")</td>
                                        <td>@c.TimesUsed / @c.MaxUses</td>
                                        <td>
                                            @if (c.IsActive && (!c.ValidUntil.HasValue || c.ValidUntil.Value > DateTime.UtcNow))
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Expired</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Transactions -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
            <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-secondary me-2"></i>Recent Payment Transactions</h5>
        </div>
        <div class="card-body px-4 pb-4">
            @if (recentTxns.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Reference</th>
                                <th>User</th>
                                <th>Method</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Gateway ID</th>
                                <th>Date & Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var txn in recentTxns)
                            {
                                <tr>
                                    <td><span class="font-monospace fw-bold text-dark">@txn.TransactionReference</span></td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(txn.User?.FullName ?? "Unknown User")</div>
                                        <small class="text-muted">@txn.User?.Email</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@txn.Method</span>
                                    </td>
                                    <td class="fw-bold text-success">৳@txn.Amount.ToString("N0") @txn.Currency</td>
                                    <td>
                                        @if (txn.Status == PaymentStatus.Completed)
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@txn.Status</span>
                                        }
                                    </td>
                                    <td><small class="font-monospace text-muted">@(txn.GatewayTransactionId ?? "N/A")</small></td>
                                    <td><small class="text-muted">@txn.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <p class="mb-0">No payment transactions recorded yet.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: New Coupon -->
<div class="modal fade" id="newCouponModal" tabindex="-1" aria-labelledby="newCouponModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="CreateCoupon" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="newCouponModalLabel">Create Promotional Coupon</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Coupon Code *</label>
                        <input type="text" name="code" class="form-control text-uppercase font-monospace" placeholder="e.g. MONSOON30" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Discount Percentage (%) *</label>
                        <input type="number" name="discountPercent" class="form-control" placeholder="25" min="1" max="100" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Maximum Redemptions</label>
                        <input type="number" name="maxUses" class="form-control" value="200" min="1" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold">Create Coupon</button>
                </div>
            </form>
        </div>
    </div>
</div>
