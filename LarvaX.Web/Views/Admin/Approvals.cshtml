@model IEnumerable<LarvaX.Core.Entities.ApplicationUser>
@{
    ViewData["Title"] = "Professional Approvals - LarvaX Admin";
}

<partial name="_AdminNav" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-person-check-fill text-warning me-2"></i>Pending Professional User Approvals</h4>
                <p class="text-muted small mb-0">Healthcare professionals (Doctors, Health Workers, Lab Staff) require administrator verification before accessing clinical systems.</p>
            </div>
            <a asp-action="Users" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to User Directory</a>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th>Professional Applicant</th>
                        <th>Email & Contact</th>
                        <th>Requested Role / Specialty</th>
                        <th>Mode</th>
                        <th class="text-end">Verification Decision</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-check2-circle fs-1 text-success mb-2 d-block"></i>
                                <h6 class="fw-bold">No Pending Approvals</h6>
                                <p class="small text-muted mb-0">All professional registrations have been reviewed.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-warning bg-opacity-25 text-dark fw-bold d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px;">
                                            @(string.IsNullOrWhiteSpace(user.FullName) ? "P" : user.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@(user.FullName ?? "Unnamed Applicant")</div>
                                            <small class="text-muted">ID: @user.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold small">@user.Email</div>
                                    <small class="text-muted">@(user.PhoneNumber ?? "No phone provided")</small>
                                </td>
                                <td>
                                    <span class="badge bg-primary rounded-pill mb-1">@(user.Specialty ?? "Clinical Specialist")</span>
                                    @if (!string.IsNullOrEmpty(user.Address))
                                    {
                                        <small class="d-block text-muted"><i class="bi bi-geo-alt me-1"></i>@user.Address</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@user.ModePreference</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <form asp-action="ApproveUser" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="bi bi-check-lg me-1"></i>Approve & Activate
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal-@user.Id">
                                            <i class="bi bi-x-lg me-1"></i>Reject
                                        </button>
                                    </div>

                                    <!-- Reject Modal -->
                                    <div class="modal fade text-start" id="rejectModal-@user.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <form asp-action="RejectUser" method="post">
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fw-bold">Reject Application: @user.FullName</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="small text-muted">
                                                            Rejecting this applicant will permanently mark their registration as rejected and prevent login access.
                                                        </p>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold">Reason for rejection:</label>
                                                            <textarea name="reason" class="form-control" required rows="3" placeholder="e.g. Invalid medical registration number, unable to verify institution affiliation"></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger btn-sm">Confirm Rejection</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
