@model IEnumerable<LarvaX.Core.Entities.Report>
@{
    ViewData["Title"] = "Report Verification - LarvaX Admin";
}

<div class="mb-4">
    <h2 class="fw-bold"><i class="bi bi-shield-check text-primary me-2"></i>Report Verification Queue</h2>
    <p class="text-muted">Review citizen-submitted breeding sites. Verify to escalate, or mark invalid.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row row-cols-1 row-cols-md-2 g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <h5 class="text-muted">No pending reports to verify.</h5>
        </div>
    }
    else
    {
        @foreach (var report in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    @if (!string.IsNullOrEmpty(report.PhotoUrl))
                    {
                        <img src="@report.PhotoUrl" class="card-img-top" alt="Report Photo" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-light text-center py-5">
                            <i class="bi bi-camera-slash display-4 text-secondary"></i>
                            <p class="text-muted mt-2 mb-0">No Photo Provided</p>
                        </div>
                    }
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">@report.DiseaseType</h5>
                            <span class="badge bg-secondary">Report #@report.Id</span>
                        </div>
                        <p class="card-text text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@report.Latitude.ToString("F6"), @report.Longitude.ToString("F6")</p>
                        <p class="card-text">@(report.Description ?? "No description provided.")</p>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">By: @report.User?.FullName</small>
                            <small class="text-muted">@report.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</small>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 d-flex gap-2 pb-3">
                        <form asp-action="VerifyReport" method="post" class="flex-grow-1">
                            <input type="hidden" name="id" value="@report.Id" />
                            <button type="submit" class="btn btn-success w-100"><i class="bi bi-check-circle me-1"></i>Verify</button>
                        </form>
                        <button type="button" class="btn btn-outline-danger flex-grow-1" data-bs-toggle="modal" data-bs-target="#rejectReportModal-@report.Id">
                            <i class="bi bi-x-circle me-1"></i>Invalid
                        </button>
                    </div>

                    <!-- Reject Modal -->
                    <div class="modal fade" id="rejectReportModal-@report.Id" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="RejectReport" method="post">
                                    <input type="hidden" name="id" value="@report.Id" />
                                    <div class="modal-header">
                                        <h5 class="modal-title">Mark Report #@report.Id as Invalid</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label">Reason for invalidation:</label>
                                            <textarea name="reason" class="form-control" required rows="3" placeholder="e.g. Photo unclear, location inaccurate, spam"></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger">Confirm Invalid</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
