@model LarvaX.Web.Models.AdminDashboardOverviewViewModel
@{
    ViewData["Title"] = "Admin Overview - LarvaX";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<partial name="_AdminNav" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- KEY STATISTICS CARDS -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-primary border-4 admin-stat-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted fw-semibold small text-uppercase">Total Users</span>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-2 text-primary">
                        <i class="bi bi-people-fill fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1">@Model.TotalUsersCount</h3>
                <div class="small text-muted d-flex justify-content-between">
                    <span>Registered Platform Accounts</span>
                    <a asp-action="Users" class="text-primary text-decoration-none fw-semibold">View <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-warning border-4 admin-stat-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted fw-semibold small text-uppercase">Approvals Pending</span>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-2 text-warning">
                        <i class="bi bi-person-exclamation fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1 text-warning">@Model.PendingApprovalsCount</h3>
                <div class="small text-muted d-flex justify-content-between">
                    <span>Professional Applicants</span>
                    <a asp-action="Approvals" class="text-warning text-decoration-none fw-semibold">Review <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-danger border-4 admin-stat-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted fw-semibold small text-uppercase">Pending Reports</span>
                    <div class="rounded-circle bg-danger bg-opacity-10 p-2 text-danger">
                        <i class="bi bi-shield-exclamation fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1 text-danger">@Model.PendingReportsCount</h3>
                <div class="small text-muted d-flex justify-content-between">
                    <span>Citizen Hazard Submissions</span>
                    <a asp-action="Reports" class="text-danger text-decoration-none fw-semibold">Verify <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-info border-4 admin-stat-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted fw-semibold small text-uppercase">Active Alerts</span>
                    <div class="rounded-circle bg-info bg-opacity-10 p-2 text-info">
                        <i class="bi bi-broadcast-pin fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1 text-info">@Model.ActiveAlertsCount</h3>
                <div class="small text-muted d-flex justify-content-between">
                    <span>Broadcasts Dispatched</span>
                    <a asp-action="Alerts" class="text-info text-decoration-none fw-semibold">Manage <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DENGUE RISK MAP SECTION -->
<div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
    <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0 text-danger"><i class="bi bi-geo-alt-fill me-2"></i>Dengue Surveillance & Risk Map</h5>
            <small class="text-muted">Real-time risk zones, verified citizen hazard clusters, and reported dengue cases.</small>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-danger rounded-pill px-3 py-2"><i class="bi bi-exclamation-diamond me-1"></i>@Model.HighRiskZonesCount High-Risk Zones</span>
            <a asp-action="RiskMonitoring" class="btn btn-sm btn-outline-danger">Full Map View</a>
        </div>
    </div>
    <div class="card-body p-0">
        <div id="adminRiskMap" style="height: 380px; width: 100%;"></div>
    </div>
    <div class="card-footer bg-light p-2 px-3 small text-muted d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex gap-3">
            <span><i class="bi bi-circle-fill text-danger me-1"></i>High Risk Zone</span>
            <span><i class="bi bi-circle-fill text-warning me-1"></i>Medium Risk Zone</span>
            <span><i class="bi bi-circle-fill text-success me-1"></i>Low Risk Zone</span>
            <span><i class="bi bi-geo-fill text-primary me-1"></i>Citizen Hazard Report</span>
        </div>
        <div>
            <form asp-action="TriggerRiskCalculation" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-secondary py-0">
                    <i class="bi bi-arrow-repeat me-1"></i>Recalculate Risk Zones Now
                </button>
            </form>
        </div>
    </div>
</div>

<!-- TWO-COLUMN LAYOUT: VERIFICATION QUEUE & RECENT ACTIVITY -->
<div class="row g-4 mb-4">
    <!-- PENDING VERIFICATION QUEUE -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-exclamation text-danger me-2"></i>Pending Verification Queue</h5>
                <a asp-action="Reports" class="btn btn-sm btn-outline-primary">View All (@Model.PendingReportsCount)</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.PendingReports.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check2-circle fs-1 text-success mb-2 d-block"></i>
                        <p class="mb-0">All citizen hazard reports have been processed.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th>Report</th>
                                    <th>Location / Notes</th>
                                    <th>Submitter</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.PendingReports)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary mb-1">#@r.Id</span>
                                            <div class="fw-bold text-dark">@r.DiseaseType</div>
                                            <small class="text-muted">@r.CreatedAt.ToString("MMM dd, HH:mm")</small>
                                        </td>
                                        <td>
                                            <small class="text-muted d-block"><i class="bi bi-geo-alt text-danger me-1"></i>@r.Latitude.ToString("F4"), @r.Longitude.ToString("F4")</small>
                                            <small class="text-truncate d-inline-block" style="max-width: 220px;">@(r.Description ?? "No description provided")</small>
                                        </td>
                                        <td>
                                            <small class="fw-semibold">@(r.User?.FullName ?? "Citizen")</small>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <form asp-action="VerifyReport" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@r.Id" />
                                                    <button type="submit" class="btn btn-success btn-sm" title="Verify report">
                                                        <i class="bi bi-check-lg"></i> Verify
                                                    </button>
                                                </form>
                                                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#quickRejectModal-@r.Id" title="Mark invalid">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </div>

                                            <!-- Quick Reject Modal -->
                                            <div class="modal fade text-start" id="quickRejectModal-@r.Id" tabindex="-1">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <form asp-action="RejectReport" method="post">
                                                            <input type="hidden" name="id" value="@r.Id" />
                                                            <div class="modal-header">
                                                                <h6 class="modal-title fw-bold">Invalidate Report #@r.Id</h6>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <label class="form-label small fw-semibold">Reason for rejection:</label>
                                                                <textarea name="reason" class="form-control form-control-sm" rows="3" required placeholder="e.g. Inaccurate location, duplicate submission, unclear photo"></textarea>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-sm btn-danger">Confirm Invalidate</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- RECENT SYSTEM ACTIVITY FEED -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history text-primary me-2"></i>Recent System Activity</h5>
                <a asp-action="ActivityLog" class="btn btn-sm btn-outline-secondary">Full Log</a>
            </div>
            <div class="card-body p-3">
                @if (!Model.RecentActivities.Any())
                {
                    <p class="text-muted text-center py-4">No recent activity recorded.</p>
                }
                else
                {
                    <div class="activity-timeline">
                        @foreach (var act in Model.RecentActivities.Take(6))
                        {
                            <div class="d-flex align-items-start mb-3">
                                <div class="badge @act.BadgeClass rounded-circle p-2 me-3 mt-1 shadow-sm">
                                    <i class="bi @act.Icon fs-6"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold small text-dark">@act.Action</span>
                                        <small class="text-muted" style="font-size: 0.75rem;">@act.Timestamp.ToString("HH:mm")</small>
                                    </div>
                                    <p class="mb-0 text-muted small">@act.Description</p>
                                    <small class="text-primary fw-semibold" style="font-size: 0.75rem;">By: @act.Actor</small>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ANALYTICS SUMMARY SECTION -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-fill text-success me-2"></i>Platform Analytics Summary</h5>
            <small class="text-muted">Key operational ratios: user distribution, verification metrics, and user journey drop-offs.</small>
        </div>
        <a asp-action="Analytics" class="btn btn-sm btn-outline-success">Deep Analytics & Charts</a>
    </div>
    <div class="card-body p-4">
        <div class="row g-4">
            <!-- User Distribution -->
            <div class="col-md-4 border-end">
                <h6 class="fw-bold mb-3 text-secondary small text-uppercase"><i class="bi bi-people me-1"></i>Users by Role</h6>
                @foreach (var kvp in Model.UsersByRole)
                {
                    var pct = Model.TotalUsersCount > 0 ? (kvp.Value * 100.0 / Model.TotalUsersCount) : 0;
                    <div class="mb-2">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="fw-semibold">@kvp.Key</span>
                            <span class="text-muted">@kvp.Value (@pct.ToString("F0")%)</span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar @(kvp.Key == "Citizen" ? "bg-primary" : kvp.Key == "Doctor" ? "bg-info" : kvp.Key == "HealthWorker" ? "bg-success" : kvp.Key == "LabStaff" ? "bg-purple" : "bg-dark")" style="width: @pct%;"></div>
                        </div>
                    </div>
                }
            </div>

            <!-- Report Status Breakdown -->
            <div class="col-md-4 border-end">
                <h6 class="fw-bold mb-3 text-secondary small text-uppercase"><i class="bi bi-pie-chart me-1"></i>Report Lifecycle Distribution</h6>
                @{
                    var totalRep = Model.PendingReportsCount + Model.VerifiedReportsCount + Model.RejectedReportsCount;
                    var verPct = totalRep > 0 ? (Model.VerifiedReportsCount * 100.0 / totalRep) : 0;
                    var penPct = totalRep > 0 ? (Model.PendingReportsCount * 100.0 / totalRep) : 0;
                    var rejPct = totalRep > 0 ? (Model.RejectedReportsCount * 100.0 / totalRep) : 0;
                }
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="fw-semibold text-success"><i class="bi bi-check-circle-fill me-1"></i>Verified & Under Action</span>
                        <span class="text-muted">@Model.VerifiedReportsCount (@verPct.ToString("F0")%)</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: @verPct%;"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="fw-semibold text-warning"><i class="bi bi-hourglass-split me-1"></i>Pending Review</span>
                        <span class="text-muted">@Model.PendingReportsCount (@penPct.ToString("F0")%)</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-warning" style="width: @penPct%;"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="fw-semibold text-danger"><i class="bi bi-x-circle-fill me-1"></i>Rejected / Invalid</span>
                        <span class="text-muted">@Model.RejectedReportsCount (@rejPct.ToString("F0")%)</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-danger" style="width: @rejPct%;"></div>
                    </div>
                </div>
            </div>

            <!-- Abandoned Flow Rates -->
            <div class="col-md-4">
                <h6 class="fw-bold mb-3 text-secondary small text-uppercase"><i class="bi bi-funnel me-1"></i>Abandoned Flow Tracking</h6>
                @if (!Model.AbandonmentRates.Any())
                {
                    <p class="text-muted small">No flow analytics data recorded yet.</p>
                }
                else
                {
                    @foreach (var kvp in Model.AbandonmentRates)
                    {
                        var rate = kvp.Value;
                        var badgeColor = rate > 40 ? "bg-danger" : rate > 20 ? "bg-warning text-dark" : "bg-success";
                        <div class="mb-2 p-2 bg-light rounded-2 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-semibold small d-block">@kvp.Key</span>
                                <small class="text-muted">Drop-off rate</small>
                            </div>
                            <span class="badge @badgeColor rounded-pill px-3 py-1">@rate.ToString("F1")%</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    .admin-stat-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .admin-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1) !important;
    }
    .bg-purple {
        background-color: #6f42c1 !important;
    }
</style>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Initialize Leaflet Map
            const map = L.map('adminRiskMap').setView([23.8103, 90.4125], 11);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            const zones = @Html.Raw(Model.MapZonesJson);
            const reports = @Html.Raw(Model.MapReportsJson);
            const cases = @Html.Raw(Model.MapCasesJson);

            // Render Risk Zones Circles
            zones.forEach(z => {
                if (z.lat && z.lng) {
                    const color = z.riskLevel === 'High' ? '#dc3545' : (z.riskLevel === 'Medium' ? '#ffc107' : '#198754');
                    const circle = L.circle([z.lat, z.lng], {
                        color: color,
                        fillColor: color,
                        fillOpacity: 0.25,
                        radius: z.radius || 3000
                    }).addTo(map);

                    circle.bindPopup(`
                        <div style="font-size: 13px;">
                            <strong style="color: ${color}; font-size: 14px;">${z.region}</strong><br/>
                            <b>Risk Level:</b> ${z.riskLevel}<br/>
                            <b>Data Sufficiency:</b> ${z.sufficiency}<br/>
                            <b>Confidence Score:</b> ${z.confidence}%
                        </div>
                    `);
                }
            });

            // Render Citizen Report Markers
            reports.forEach(r => {
                if (r.lat && r.lng) {
                    const marker = L.circleMarker([r.lat, r.lng], {
                        radius: 6,
                        color: '#0d6efd',
                        fillColor: '#0d6efd',
                        fillOpacity: 0.8
                    }).addTo(map);

                    marker.bindPopup(`
                        <div style="font-size: 12px;">
                            <strong>Citizen Report #${r.id}</strong><br/>
                            <b>Disease:</b> ${r.diseaseType}<br/>
                            <b>Status:</b> ${r.status}<br/>
                            <b>Details:</b> ${r.desc}
                        </div>
                    `);
                }
            });

            // Render Confirmed Case Markers
            cases.forEach(c => {
                if (c.lat && c.lng) {
                    const caseMarker = L.circleMarker([c.lat, c.lng], {
                        radius: 5,
                        color: '#6f42c1',
                        fillColor: '#6f42c1',
                        fillOpacity: 0.9
                    }).addTo(map);

                    caseMarker.bindPopup(`
                        <div style="font-size: 12px;">
                            <strong>Case: ${c.name}</strong><br/>
                            <b>Status:</b> ${c.status}<br/>
                            <b>Severity:</b> ${c.severity}
                        </div>
                    `);
                }
            });
        });
    </script>
}
