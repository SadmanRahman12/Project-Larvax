@model LarvaX.Web.Models.AdminAnalyticsViewModel
@{
    ViewData["Title"] = "Platform Analytics - LarvaX Admin";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<partial name="_AdminNav" />

<!-- HEADER -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-graph-up-arrow text-danger me-2"></i>Platform Operational & Flow Analytics</h4>
                <p class="text-muted small mb-0">System metrics, user conversion rates, disease epidemiology distribution, and user journey flow drop-off tracking.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="DataReports" class="btn btn-sm btn-outline-secondary"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Data Export</a>
            </div>
        </div>
    </div>
</div>

<!-- KEY HIGH LEVEL TOTALS -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 border-start border-primary border-4">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Platform Users</span>
                <h3 class="fw-bold mb-0 text-primary">@Model.TotalUsers</h3>
                <small class="text-muted">Citizens & clinical staff</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 border-start border-success border-4">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Citizen Reports</span>
                <h3 class="fw-bold mb-0 text-success">@Model.TotalReports</h3>
                <small class="text-muted">Hazard site submissions</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 border-start border-danger border-4">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Surveillance Cases</span>
                <h3 class="fw-bold mb-0 text-danger">@Model.TotalCases</h3>
                <small class="text-muted">Hospital dengue records</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 border-start border-warning border-4">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Alert Dispatches</span>
                <h3 class="fw-bold mb-0 text-warning">@Model.TotalAlerts</h3>
                <small class="text-muted">Sent to active populations</small>
            </div>
        </div>
    </div>
</div>

<!-- CHARTS ROW 1: USER ROLES & REPORT VERIFICATION -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white p-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-people me-2 text-primary"></i>User Distribution by Role</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center p-3" style="min-height: 280px;">
                <canvas id="userRolesChart" style="max-height: 250px;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white p-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart me-2 text-success"></i>Report Verification Status Breakdown</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center p-3" style="min-height: 280px;">
                <canvas id="reportStatusChart" style="max-height: 250px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- CHARTS ROW 2: DAILY REPORT TREND & DISEASE BREAKDOWN -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white p-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up me-2 text-danger"></i>Daily Citizen Hazard Report Submissions (Past 14 Days)</h6>
            </div>
            <div class="card-body p-3" style="min-height: 260px;">
                <canvas id="reportTrendChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white p-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart me-2 text-info"></i>Reports by Vector Disease</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center p-3" style="min-height: 260px;">
                <canvas id="diseaseChart" style="max-height: 230px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- SECTION: ABANDONED USER FLOW ANALYTICS -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-funnel-fill text-warning me-2"></i>Abandoned User Flow Tracking</h5>
            <small class="text-muted">LarvaX flow funnel analytics: identifying friction points where citizens and patients drop off.</small>
        </div>
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Implementation Plan Core Metric</span>
    </div>
    <div class="card-body p-4">
        <div class="row g-4">
            @foreach (var flow in Model.FlowStepCounts)
            {
                var flowName = flow.Key;
                var steps = flow.Value;
                var abandonRate = Model.FlowAbandonmentRates.ContainsKey(flowName) ? Model.FlowAbandonmentRates[flowName] : 0.0;
                var rateBadge = abandonRate > 40 ? "bg-danger" : abandonRate > 20 ? "bg-warning text-dark" : "bg-success";

                int maxCount = steps.Values.Any() ? steps.Values.Max() : 1;
                if (maxCount == 0) maxCount = 1;

                <div class="col-md-6 col-xl-3">
                    <div class="card border bg-light h-100 p-3 rounded-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="fw-bold text-dark mb-0">@flowName</h6>
                            <span class="badge @rateBadge rounded-pill">@abandonRate.ToString("F1")% drop</span>
                        </div>
                        <small class="text-muted d-block mb-3">Abandonment Rate</small>

                        <div class="flow-steps">
                            @foreach (var step in steps)
                            {
                                var pct = (step.Value * 100.0 / maxCount);
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span class="fw-semibold text-dark">@step.Key</span>
                                        <span>@step.Value (@pct.ToString("F0")%)</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-primary" style="width: @pct%;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. User Roles Doughnut Chart
            const roleLabels = @Html.Raw(Model.UserRoleLabelsJson);
            const roleValues = @Html.Raw(Model.UserRoleValuesJson);
            new Chart(document.getElementById('userRolesChart'), {
                type: 'doughnut',
                data: {
                    labels: roleLabels,
                    datasets: [{
                        data: roleValues,
                        backgroundColor: ['#0d6efd', '#0dcaf0', '#198754', '#6f42c1', '#212529', '#ffc107']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            // 2. Report Verification Pie Chart
            const statusLabels = @Html.Raw(Model.ReportStatusLabelsJson);
            const statusValues = @Html.Raw(Model.ReportStatusValuesJson);
            new Chart(document.getElementById('reportStatusChart'), {
                type: 'pie',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusValues,
                        backgroundColor: ['#ffc107', '#198754', '#dc3545']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            // 3. Daily Report Trend Line Chart
            const trendLabels = @Html.Raw(Model.DailyReportTrendLabelsJson);
            const trendValues = @Html.Raw(Model.DailyReportTrendValuesJson);
            new Chart(document.getElementById('reportTrendChart'), {
                type: 'line',
                data: {
                    labels: trendLabels,
                    datasets: [{
                        label: 'Submitted Reports',
                        data: trendValues,
                        borderColor: '#dc3545',
                        backgroundColor: 'rgba(220, 53, 69, 0.1)',
                        fill: true,
                        tension: 0.35,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });

            // 4. Disease Bar Chart
            const diseaseLabels = @Html.Raw(Model.DiseaseLabelsJson);
            const diseaseValues = @Html.Raw(Model.DiseaseValuesJson);
            new Chart(document.getElementById('diseaseChart'), {
                type: 'bar',
                data: {
                    labels: diseaseLabels,
                    datasets: [{
                        label: 'Reports',
                        data: diseaseValues,
                        backgroundColor: '#0dcaf0'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        });
    </script>
}
