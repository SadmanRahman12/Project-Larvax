@{
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}

<div class="card shadow-sm border-0 mb-4 bg-white rounded-3 overflow-hidden">
    <div class="card-body p-3 bg-light border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-danger text-white rounded-3 p-2 px-3 d-flex align-items-center shadow-sm">
                <i class="bi bi-shield-lock-fill fs-4 me-2"></i>
                <div>
                    <h5 class="fw-bold mb-0 text-white">LarvaX Administrator</h5>
                    <small class="text-white-50">Centralized Platform Control Console</small>
                </div>
            </div>
            <div class="d-none d-lg-block border-start ps-3 py-1">
                <span class="badge bg-dark px-3 py-2 rounded-pill"><i class="bi bi-clock-history me-1"></i>System Active: @DateTime.UtcNow.ToString("dd MMM yyyy")</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="RiskMonitoring" class="btn btn-sm btn-outline-danger shadow-sm">
                <i class="bi bi-geo-alt-fill me-1"></i>Live Risk Map
            </a>
            <a asp-action="Alerts" class="btn btn-sm btn-danger shadow-sm">
                <i class="bi bi-broadcast-pin me-1"></i>Broadcast Alert
            </a>
        </div>
    </div>
    <div class="p-2 px-3 bg-white">
        <ul class="nav nav-pills flex-nowrap overflow-auto gap-1 py-1" style="white-space: nowrap;">
            <li class="nav-item">
                <a class="nav-link rounded-pill py-2 px-3 @(currentAction == "Index" ? "active bg-danger text-white shadow-sm" : "text-dark hover-bg")" asp-action="Index">
                    <i class="bi bi-speedometer2 me-1"></i>Overview
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill py-2 px-3 @(currentAction == "Users" ? "active bg-danger text-white shadow-sm" : "text-dark hover-bg")" asp-action="Users">
                    <i class="bi bi-people-fill me-1"></i>User Management
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill py-2 px-3 @(currentAction == "Approvals" ? "active bg-danger text-white shadow-sm" : "text-dark hover-bg")" asp-action="Approvals">
                    <i class="bi bi-person-check-fill me-1"></i>Approvals
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill py-2 px-3 @(currentAction == "Reports" ? "active bg-danger text-white shadow-sm" : "text-dark hover-bg")" asp-action="Reports">
                    <i class="bi bi-shield-check me-1"></i>Report Queue
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill py-2 px-3 @(currentAction == "RiskMonitoring" ? "active bg-danger text-white shadow-sm" : "text-dark hover-bg")" asp-action="RiskMonitoring">
                    <i class="bi bi-activity me-1"></i>Risk Monitoring
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill py-2 px-3 @(currentAction == "Alerts" ? "active bg-danger text-white shadow-sm" : "text-dark hover-bg")" asp-action="Alerts">
                    <i class="bi bi-bell-fill me-1"></i>Alerts
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill py-2 px-3 @(currentAction == "Analytics" ? "active bg-danger text-white shadow-sm" : "text-dark hover-bg")" asp-action="Analytics">
                    <i class="bi bi-graph-up-arrow me-1"></i>Analytics
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill py-2 px-3 @(currentAction == "ActivityLog" ? "active bg-danger text-white shadow-sm" : "text-dark hover-bg")" asp-action="ActivityLog">
                    <i class="bi bi-journal-text me-1"></i>Audit Log
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill py-2 px-3 @(currentAction == "DataReports" ? "active bg-danger text-white shadow-sm" : "text-dark hover-bg")" asp-action="DataReports">
                    <i class="bi bi-file-earmark-spreadsheet me-1"></i>Data & Reports
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill py-2 px-3 @(currentAction == "Settings" ? "active bg-danger text-white shadow-sm" : "text-dark hover-bg")" asp-action="Settings">
                    <i class="bi bi-gear-fill me-1"></i>Settings
                </a>
            </li>
        </ul>
    </div>
</div>

<style>
    .hover-bg:hover {
        background-color: #f8f9fa;
        color: #dc3545 !important;
    }
</style>
