@using LarvaX.Core.Entities
@model InventoryItem
@{
    ViewData["Title"] = "Add Inventory Item";
    var isBn = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("bn");
}

<div class="container py-4" style="max-width:600px">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-primary">@(isBn ? "ইনভেন্টরি" : "Inventory")</a></li>
            <li class="breadcrumb-item active">@(isBn ? "নতুন আইটেম" : "New Item")</li>
        </ol>
    </nav>
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h1 class="h4 fw-bold mb-4"><i class="bi bi-plus-circle me-2 text-primary"></i>@(isBn ? "ইনভেন্টরি আইটেম যোগ করুন" : "Add Inventory Item")</h1>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">@(isBn ? "আইটেমের নাম" : "Item Name")</label>
                <input asp-for="Name" class="form-control rounded-3" placeholder="@(isBn ? "যেমন: র‍্যাপিড টেস্ট কিট" : "e.g., Rapid Test Kit")" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Quantity" class="form-label fw-semibold">@(isBn ? "প্রাথমিক পরিমাণ" : "Initial Quantity")</label>
                <input asp-for="Quantity" type="number" class="form-control rounded-3" min="0" required />
            </div>
            <div class="mb-3">
                <label asp-for="Threshold" class="form-label fw-semibold">@(isBn ? "সতর্কতা সীমা (কম স্টক সতর্কতা)" : "Low Stock Threshold")</label>
                <input asp-for="Threshold" type="number" class="form-control rounded-3" min="0" required />
            </div>
            <div class="mb-4">
                <label asp-for="Location" class="form-label fw-semibold">@(isBn ? "সংরক্ষণ স্থান" : "Storage Location")</label>
                <input asp-for="Location" class="form-control rounded-3" placeholder="@(isBn ? "যেমন: মূল গুদাম" : "e.g., Main Storage")" required />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-plus-circle me-1"></i>@(isBn ? "যোগ করুন" : "Add Item")
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">@(isBn ? "বাতিল" : "Cancel")</a>
            </div>
        </form>
    </div>
</div>
