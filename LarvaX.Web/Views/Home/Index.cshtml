@{
    ViewData["Title"] = "Dengue Surveillance & Health Intelligence";
}

<!-- Interactive Live Map Section -->
<div class="card border-0 shadow-sm mb-4 overflow-hidden rounded-3">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-map-fill me-2 text-warning"></i>Live Risk Map</h5>
        <div class="d-flex gap-2">
            <span class="badge bg-danger"><i class="bi bi-circle-fill me-1"></i>High Risk</span>
            <span class="badge bg-warning text-dark"><i class="bi bi-circle-fill me-1"></i>Medium Risk</span>
            <span class="badge bg-success"><i class="bi bi-circle-fill me-1"></i>Low Risk</span>
        </div>
    </div>
    <div class="card-body p-0 position-relative">
        <div id="riskMap" style="height: 400px; width: 100%; z-index: 1;"></div>
        <div class="position-absolute bottom-0 start-0 m-3 z-3">
            <a asp-controller="Reports" asp-action="Create" class="btn btn-warning shadow-sm fw-bold">
                <i class="bi bi-geo-alt-fill me-1"></i> Report Hazard
            </a>
        </div>
    </div>
</div>

<!-- Map Dependencies -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Initialize map centered on Bangladesh
        var map = L.map('riskMap').setView([23.6850, 90.3563], 7);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
            subdomains: 'abcd',
            maxZoom: 20
        }).addTo(map);

        // Fetch live data
        fetch('/Home/MapData')
            .then(response => response.json())
            .then(data => {
                let bounds = [];
                data.forEach(zone => {
                    let color = zone.riskLevel === 'High' ? '#dc3545' : (zone.riskLevel === 'Medium' ? '#ffc107' : '#198754');
                    
                    let circle = L.circle([zone.lat, zone.lng], {
                        color: color,
                        fillColor: color,
                        fillOpacity: 0.4,
                        radius: zone.radius
                    }).addTo(map);

                    circle.bindPopup(`<b>${zone.region}</b><br>Risk: <span class="badge" style="background-color:${color}">${zone.riskLevel}</span><br>Confidence: ${(zone.confidence * 100).toFixed(0)}%`);
                    bounds.push([zone.lat, zone.lng]);
                });

                if (bounds.length > 0) {
                    map.fitBounds(bounds, { padding: [50, 50] });
                }
            })
            .catch(err => console.error("Error loading map data:", err));
    });
</script>

<!-- Surveillance Quick Stats -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm border-start border-danger border-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted fw-semibold mb-1">Active Suspected Hotspots</h6>
                        <h2 class="fw-bold mb-0 text-danger">1,280</h2>
                        <small class="text-success fw-semibold"><i class="bi bi-arrow-down-right"></i> ↓ 8.4% from last week</small>
                    </div>
                    <div class="fs-1 text-danger opacity-50"><i class="bi bi-bug-fill"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm border-start border-success border-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted fw-semibold mb-1">Larvicide Actions Completed</h6>
                        <h2 class="fw-bold mb-0 text-success">845</h2>
                        <small class="text-success fw-semibold"><i class="bi bi-arrow-up-right"></i> ↑ 14.2% verified</small>
                    </div>
                    <div class="fs-1 text-success opacity-50"><i class="bi bi-check-circle-fill"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm border-start border-primary border-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted fw-semibold mb-1">Emergency ICU Beds Available</h6>
                        <h2 class="fw-bold mb-0 text-primary">48</h2>
                        <small class="text-muted"><i class="bi bi-clock-history"></i> Last confirmed: 12m ago</small>
                    </div>
                    <div class="fs-1 text-primary opacity-50"><i class="bi bi-hospital-fill"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Navigation Portals -->
<h4 class="fw-bold mb-3"><i class="bi bi-grid-fill text-primary me-2"></i>Community Health Services</h4>
<div class="row row-cols-1 row-cols-md-3 g-4 mb-5">
    <div class="col">
        <div class="card h-100 border-0 shadow-sm text-center p-3 hover-shadow">
            <div class="card-body">
                <div class="fs-1 text-primary mb-2"><i class="bi bi-chat-dots-fill"></i></div>
                <h5 class="card-title fw-bold">DenAI Chatbot</h5>
                <p class="card-text text-muted small">Bilingual AI assistant for dengue prevention, symptom queries, and triage support.</p>
                <a asp-controller="Chatbot" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">Ask DenAI</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 border-0 shadow-sm text-center p-3 hover-shadow">
            <div class="card-body">
                <div class="fs-1 text-danger mb-2"><i class="bi bi-heart-pulse-fill"></i></div>
                <h5 class="card-title fw-bold">AI Symptom Checker</h5>
                <p class="card-text text-muted small">Step-by-step risk questionnaire with immediate emergency triage routing.</p>
                <a asp-controller="SymptomChecker" asp-action="Index" class="btn btn-outline-danger btn-sm rounded-pill px-3">Check Symptoms</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 border-0 shadow-sm text-center p-3 hover-shadow">
            <div class="card-body">
                <div class="fs-1 text-danger mb-2"><i class="bi bi-droplet-fill"></i></div>
                <h5 class="card-title fw-bold">Blood & Platelet Donors</h5>
                <p class="card-text text-muted small">Find verified blood donors sorted by freshness timestamp and distance.</p>
                <a asp-controller="Donors" asp-action="Index" class="btn btn-outline-danger btn-sm rounded-pill px-3">Find Donors</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 border-0 shadow-sm text-center p-3 hover-shadow">
            <div class="card-body">
                <div class="fs-1 text-primary mb-2"><i class="bi bi-camera-video-fill"></i></div>
                <h5 class="card-title fw-bold">Telemedicine</h5>
                <p class="card-text text-muted small">Find a doctor and book a video consultation. Secure, on-demand telehealth.</p>
                <a asp-controller="Telemedicine" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">Find a Doctor</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-2 text-success me-3"><i class="bi bi-book-half"></i></div>
                    <div>
                        <h5 class="fw-bold mb-0">Awareness & Education</h5>
                        <small class="text-muted">Bilingual myth-busting and health learning</small>
                    </div>
                </div>
                <p class="text-muted mb-3">Browse dengue prevention guides, complete a short quiz, and download a certificate.</p>
                <a asp-controller="Education" asp-action="Index" class="btn btn-success">Open learning portal</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-2 text-info me-3"><i class="bi bi-hospital"></i></div>
                    <div>
                        <h5 class="fw-bold mb-0">ICU Bed Finder</h5>
                        <small class="text-muted">Urgent care reference for Bangladesh</small>
                    </div>
                </div>
                <p class="text-muted mb-3">Use the finder to locate major hospitals and emergency contacts, then verify live availability with the hospital before travel.</p>
                <a asp-controller="IcuBeds" asp-action="Index" class="btn btn-info text-white">Open ICU finder</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-2 text-primary me-3"><i class="bi bi-droplet-half"></i></div>
                    <div>
                        <h5 class="fw-bold mb-0">Dengue Fluid Management</h5>
                        <small class="text-muted">WHO-aligned fluid therapy support</small>
                    </div>
                </div>
                <p class="text-muted mb-3">Calculate maintenance fluids, deficits, boluses, and monitor cumulative fluid intake safely in a bilingual healthcare workflow.</p>
                <a asp-controller="FluidManagement" asp-action="Index" class="btn btn-primary">Open fluid assistant</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="fs-2 text-warning me-3"><i class="bi bi-calendar3"></i></div>
                    <div>
                        <h5 class="fw-bold mb-0">Oral Rehydration Planner</h5>
                        <small class="text-muted">Schedule-based patient guidance</small>
                    </div>
                </div>
                <p class="text-muted mb-3">Generate an hourly schedule for severe, critical, or maintenance-phase dengue patients with monitoring points and warning signs.</p>
                <a asp-controller="FluidManagement" asp-action="Planner" class="btn btn-warning text-dark">Open planner</a>
            </div>
        </div>
    </div>
    @if (User.IsInRole("GovernmentAuthority") || User.IsInRole("Administrator"))
    {
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="fs-2 text-warning me-3"><i class="bi bi-shield-check"></i></div>
                        <div>
                            <h5 class="fw-bold mb-0">Government Surveillance</h5>
                            <small class="text-muted">National dashboard and exports</small>
                        </div>
                    </div>
                    <p class="text-muted mb-3">Review regional risk zones, insufficient-data flags, and export surveillance records for public health agencies.</p>
                    <a asp-controller="Government" asp-action="Dashboard" class="btn btn-warning text-dark">Open dashboard</a>
                </div>
            </div>
        </div>
    }
</div>
