@model IEnumerable<LarvaX.Core.Entities.ApplicationUser>
@{
    ViewData["Title"] = "Telemedicine - Find a Doctor";
}

<div class="mb-4">
    <h2 class="fw-bold"><i class="bi bi-person-badge"></i> Find a Doctor</h2>
    <p class="text-muted">Browse available doctors and book a video consultation.</p>
</div>

<form method="get" class="mb-4 d-flex gap-2 w-50">
    <input type="text" name="specialty" class="form-control" placeholder="Filter by Specialty (e.g. Cardiologist)" value="@Context.Request.Query["specialty"]" />
    <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Search</button>
    @if (!string.IsNullOrEmpty(Context.Request.Query["specialty"]))
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    }
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No doctors registered yet.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var d in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="fw-bold mb-1">@d.FullName</h5>
                            @if (!string.IsNullOrEmpty(d.Specialty))
                            {
                                <span class="badge bg-info text-dark mb-2">@d.Specialty</span>
                            }
                            <p class="text-muted small mb-0">@d.Email</p>
                        </div>
                        <div class="text-end">
                            <a asp-action="Book" asp-route-doctorId="@d.Id" class="btn btn-primary">Book</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
