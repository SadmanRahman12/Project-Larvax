@model IEnumerable<LarvaX.Core.Entities.Report>
@{
    ViewData["Title"] = "Community Reports - LarvaX";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-clipboard-data text-primary me-2"></i>Breeding Site & Case Reports</h2>
        <p class="text-muted mb-0">Track verification and status progression: <strong>Received → Under Review → Resolved</strong></p>
    </div>
    <a asp-action="Create" class="btn btn-danger">
        <i class="bi bi-plus-circle me-1"></i> Submit New Report
    </a>
</div>

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-map me-2"></i>Hazard Map</h5>
            </div>
            <div class="card-body p-0">
                <div id="reportsMap" style="height: 400px; width: 100%; border-bottom-left-radius: 0.375rem; border-bottom-right-radius: 0.375rem;"></div>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Photo</th>
                        <th>Disease</th>
                        <th>Coordinates</th>
                        <th>Description</th>
                        <th>Submitted At</th>
                        <th>Status Progression</th>
                        <th>Verification</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No reports submitted yet. Be the first to report a mosquito hazard!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var report in Model)
                        {
                            <tr>
                                <td class="fw-semibold">#@report.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(report.PhotoUrl))
                                    {
                                        <img src="@report.PhotoUrl" alt="Site Photo" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border"><i class="bi bi-image"></i> No photo</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">@report.DiseaseType</span>
                                </td>
                                <td class="small font-monospace">
                                    @report.Latitude.ToString("F4"), @report.Longitude.ToString("F4")
                                </td>
                                <td class="text-truncate" style="max-width: 200px;" title="@report.Description">
                                    @(report.Description ?? "No description provided")
                                </td>
                                <td class="small text-muted">
                                    @report.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td>
                                    @if (report.Status == LarvaX.Core.Entities.ReportStatus.Received)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-inbox me-1"></i>Received</span>
                                    }
                                    else if (report.Status == LarvaX.Core.Entities.ReportStatus.UnderReview)
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-search me-1"></i>Under Review</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-all me-1"></i>Resolved</span>
                                    }
                                </td>
                                <td>
                                    @if (report.Verification == LarvaX.Core.Entities.ReportVerification.Pending)
                                    {
                                        <span class="badge bg-secondary">Pending</span>
                                    }
                                    else if (report.Verification == LarvaX.Core.Entities.ReportVerification.Verified)
                                    {
                                        <span class="badge bg-success">Verified</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" title="@report.RejectionReason">Invalid</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Default center (Dhaka)
            var map = L.map('reportsMap').setView([23.8103, 90.4125], 11);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            var reports = [
                @foreach(var r in Model) {
                    @:{ lat: @r.Latitude, lng: @r.Longitude, disease: "@r.DiseaseType", status: "@r.Status", verification: "@r.Verification" },
                }
            ];

            var bounds = [];

            reports.forEach(function(r) {
                var color = r.verification === "Verified" ? "red" : (r.verification === "Invalid" ? "gray" : "orange");
                
                var markerHtml = `<div style="background-color: ${color}; width: 15px; height: 15px; border-radius: 50%; border: 2px solid white; box-shadow: 0 0 4px rgba(0,0,0,0.5);"></div>`;
                var icon = L.divIcon({ html: markerHtml, className: 'custom-leaflet-icon', iconSize: [15, 15], iconAnchor: [7, 7] });
                
                var marker = L.marker([r.lat, r.lng], { icon: icon }).addTo(map);
                marker.bindPopup(`<b>${r.disease}</b><br/>Status: ${r.status}<br/>Verification: ${r.verification}`);
                
                bounds.push([r.lat, r.lng]);
            });

            if (bounds.length > 0) {
                map.fitBounds(bounds);
            }
        });
    </script>
}
