@model LarvaX.Web.Controllers.PatientRecordViewModel

@{
    ViewData["Title"] = "Add Medical Record";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Add Medical Record</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Record Title</label>
                            <input asp-for="Title" class="form-control" placeholder="e.g., CBC Blood Test Results" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="RecordType" class="form-label">Record Type</label>
                            <select asp-for="RecordType" class="form-select">
                                <option value="Prescription">Prescription</option>
                                <option value="LabResult">Lab Result</option>
                                <option value="MedicalHistory">Medical History</option>
                                <option value="DischargeSummary">Discharge Summary</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description / Notes</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="FileUrl" class="form-label">Document Link (Simulated Upload)</label>
                            <input asp-for="FileUrl" class="form-control" placeholder="https://example.com/file.pdf" />
                            <small class="text-muted">In this phase, just paste a link to your file.</small>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Save Record</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
