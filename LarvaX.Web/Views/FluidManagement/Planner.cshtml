@model LarvaX.Web.Controllers.OralRehydrationPlannerViewModel
@{
    ViewData["Title"] = "Oral Rehydration Planner";

    var initialBolus = Model.ShockStatus ? (Model.PatientType == "Pediatric" ? 20m * Model.Weight : 10m * Model.Weight) : 0m;
    var maintenanceMl = Model.Weight <= 10m ? Model.Weight * 100m : (Model.Weight <= 20m ? 1000m + 50m * (Model.Weight - 10m) : 1500m + 20m * (Model.Weight - 20m));
    var hourlyRate = Model.ShockStatus ? (Model.PatientType == "Pediatric" ? 5m * Model.Weight : 7m * Model.Weight) : (Model.DenguePhase == "CriticalPhase" ? 4m * Model.Weight : maintenanceMl / 24m);
    var deficitMl = Model.DeficitPercent * Model.Weight * 10m;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Oral Rehydration & Fluid Planner</h2>
            <p class="text-muted mb-0">Adult and pediatric dengue fluid schedule planning support.</p>
        </div>
        <a asp-controller="FluidManagement" asp-action="Index" class="btn btn-outline-primary">Back to fluid assistant</a>
    </div>

    <form asp-action="Planner" method="post" class="row g-4">
        @Html.AntiForgeryToken()
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Patient classification</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="PatientType" class="form-label">Patient type</label>
                            <select asp-for="PatientType" class="form-select">
                                <option value="Adult">Adult</option>
                                <option value="Pediatric">Pediatric</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DenguePhase" class="form-label">Dengue phase</label>
                            <select asp-for="DenguePhase" class="form-select">
                                <option value="CriticalPhase">Critical Phase</option>
                                <option value="MaintenancePhase">Maintenance Phase</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Weight" class="form-label">Weight (kg)</label>
                            <input asp-for="Weight" class="form-control" />
                            <span asp-validation-for="Weight" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Age" class="form-label">Age</label>
                            <input asp-for="Age" class="form-control" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="ShockStatus" class="form-check-input" />
                                <label asp-for="ShockStatus" class="form-check-label">Shock present</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Education and monitoring</h5>
                    <ul class="mb-3">
                        <li>Target urine output: at least 0.5 mL/kg/hr.</li>
                        <li>Monitor pulse, blood pressure, hematocrit, and mental status.</li>
                        <li>Look for fluid overload, rising respiratory effort, or worsening distress.</li>
                    </ul>
                    <div class="alert alert-warning mb-0" role="alert">
                        ORS, coconut water, and oral fluids may be helpful when clinically appropriate, but use medical reassessment for severe cases.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 text-center">
            <button type="submit" class="btn btn-danger btn-lg px-4">Generate fluid plan</button>
        </div>
    </form>

    @if (Model.Schedule.Any())
    {
        <div class="card shadow-sm border-0 mt-5">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">Plan summary</h4>
                <div class="row g-3 mb-4">
                    <div class="col-md-3"><div class="border rounded p-3"><small class="text-muted">Initial bolus</small><div class="fw-bold">@initialBolus.ToString("N0") mL</div></div></div>
                    <div class="col-md-3"><div class="border rounded p-3"><small class="text-muted">Maintenance (24h)</small><div class="fw-bold">@maintenanceMl.ToString("N0") mL</div></div></div>
                    <div class="col-md-3"><div class="border rounded p-3"><small class="text-muted">Hourly rate</small><div class="fw-bold">@hourlyRate.ToString("N1") mL/hr</div></div></div>
                    <div class="col-md-3"><div class="border rounded p-3"><small class="text-muted">Deficit fluid</small><div class="fw-bold">@deficitMl.ToString("N0") mL</div></div></div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Hour</th>
                                <th>Phase</th>
                                <th>Volume</th>
                                <th>Duration</th>
                                <th>Clinical note</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Schedule)
                            {
                                <tr>
                                    <td>@item.Hour</td>
                                    <td>@item.Phase</td>
                                    <td>@item.VolumeMl.ToString("N0") mL</td>
                                    <td>@item.Duration</td>
                                    <td>@item.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 mt-5">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3">Formulas and clinical basis</h4>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="fw-bold text-danger">1. Holliday-Segar maintenance formula</h6>
                        <p class="mb-1"><strong>≤ 10 kg:</strong> 100 mL/kg/day</p>
                        <p class="mb-1"><strong>10–20 kg:</strong> 1000 + 50 × (weight − 10) mL/day</p>
                        <p class="mb-0"><strong>> 20 kg:</strong> 1500 + 20 × (weight − 20) mL/day</p>
                        <p class="mt-2 text-muted">This calculation approximates daily maintenance requirements and is widely used for fluid replacement in pediatric and adult clinical calculations.</p>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="fw-bold text-danger">2. Deficit volume</h6>
                        <p class="mb-0"><strong>Deficit (mL) = Dehydration % × Weight (kg) × 10</strong></p>
                        <p class="mt-2 text-muted">The deficit represents estimated water and electrolyte loss, often replaced in stages to reduce the risk of complications from rapid volume correction.</p>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="fw-bold text-danger">3. Shock bolus protocol</h6>
                        <p class="mb-1"><strong>Pediatric shock:</strong> 20 mL/kg bolus</p>
                        <p class="mb-0"><strong>Adult shock:</strong> 10 mL/kg bolus</p>
                        <p class="mt-2 text-muted">This protocol follows the principle of rapid crystalloid boluses for intravascular volume restoration while reassessing perfusion and response at short intervals.</p>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="fw-bold text-danger">4. Monitoring-based clinical reasoning</h6>
                        <p class="mb-0">Hourly fluid planning is adjusted using urine output, hematocrit trends, blood pressure, pulse, and signs of fluid overload.</p>
                        <p class="mt-2 text-muted">This watchful approach is used because dengue can progress rapidly from compensated shock to fluid overload if fluids are not titrated carefully.</p>
                    </div>
                </div>
            </div>

            <div class="mt-4 border rounded p-3 bg-light">
                <h6 class="fw-bold mb-2">Clinical reference base</h6>
                <p class="mb-0">These calculations are designed to be consistent with WHO dengue guidance, Ministry of Health recommendations, and standard resuscitation principles for hemodynamic assessment and fluid replacement.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
