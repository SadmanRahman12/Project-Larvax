<!-- Modal: Create Clinical Referral -->
<div class="modal fade" id="modalCreateReferral" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-danger text-white rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-arrow-up-right-circle-fill me-2"></i> Clinical Referral / Escalation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateReferral" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="DengueCaseId" id="referralCaseId" />
                <div class="modal-body p-4">
