                            <option value="@ReportStatus.UnderReview">Under Review</option>
                            <option value="@ReportStatus.Assigned">Assigned</option>
                            <option value="@ReportStatus.Investigating">Investigating</option>
                            <option value="@ReportStatus.Resolved">Resolved</option>
                            <option value="@ReportStatus.Escalated">Escalated</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Verification Decision</label>
                        <select name="Verification" id="updateReportVerification" class="form-select rounded-3">
