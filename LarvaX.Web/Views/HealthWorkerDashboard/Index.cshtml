                    <button type="submit" class="btn btn-warning rounded-pill px-4 text-dark fw-bold">Update Report</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Dispense / Restock Inventory -->
<div class="modal fade" id="modalAdjustInventory" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-info text-dark rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-box-seam me-2"></i> Dispense / Restock Supplies</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AdjustInventory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Select Supply Item</label>
                        <select name="ItemId" id="adjustItemId" class="form-select rounded-3" required>
                            @foreach (var itm in Model.InventoryItems)
                            {
                                <option value="@itm.Id">@itm.Name (Available: @itm.Quantity units)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Quantity Change</label>
                        <input type="number" name="QuantityChange" id="adjustQtyChange" class="form-control rounded-3" placeholder="Positive to restock (+20), Negative to dispense (-5)" required />
                        <small class="text-muted">Use <strong>+10</strong> when receiving stock; use <strong>-5</strong> when dispensing to field clinics or patients.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Reason / Destination</label>
                        <input type="text" name="Reason" class="form-control rounded-3" placeholder="e.g. Dispensed to Dhanmondi Clinic / Received from Central Depot" required />
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info rounded-pill px-4 fw-bold">Record Transaction</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add New Inventory Item -->
