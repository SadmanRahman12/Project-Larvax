<!-- Modal: Register Dengue Case -->
<div class="modal fade" id="modalAddCase" tabindex="-1" aria-labelledby="modalAddCaseLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="modalAddCaseLabel"><i class="bi bi-person-plus-fill me-2"></i> Register Dengue Case</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddCase" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Patient Name <span class="text-danger">*</span></label>
                            <input type="text" name="PatientName" class="form-control rounded-3" placeholder="Full Name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Patient Phone Number</label>
                            <input type="text" name="PatientPhone" class="form-control rounded-3" placeholder="+8801..." />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Patient Address</label>
                            <input type="text" name="PatientAddress" class="form-control rounded-3" placeholder="House, Road, Area, City" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold">Age</label>
                            <input type="number" name="Age" class="form-control rounded-3" value="25" min="1" max="120" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold">Gender</label>
                            <select name="Gender" class="form-select rounded-3">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Case Status</label>
                            <select name="Status" class="form-select rounded-3">
                                <option value="@CaseStatus.Suspected">Suspected</option>
                                <option value="@CaseStatus.UnderObservation">Under Observation</option>
                                <option value="@CaseStatus.Confirmed">Confirmed</option>
                                <option value="@CaseStatus.Recovering">Recovering</option>
                                <option value="@CaseStatus.Closed">Closed</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Clinical Severity</label>
                            <select name="Severity" class="form-select rounded-3">
                                <option value="@CaseSeverity.Mild">Mild (Non-severe dengue without warning signs)</option>
                                <option value="@CaseSeverity.Moderate">Moderate (Dengue with warning signs)</option>
                                <option value="@CaseSeverity.Severe">Severe (Severe plasma leakage / bleeding)</option>
                                <option value="@CaseSeverity.Critical">Critical (Dengue Shock Syndrome / Multi-organ)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Platelet Count (/μL)</label>
                            <input type="number" name="PlateletCount" class="form-control rounded-3" placeholder="e.g. 95000" />
                            <small class="text-muted">Thresholds: Normal &gt;150k, Warning &lt;100k, Severe &lt;50k</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Hematocrit (HCT %)</label>
                            <input type="number" step="0.1" name="Hematocrit" class="form-control rounded-3" placeholder="e.g. 42.5" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Latitude (GPS)</label>
                            <input type="number" step="0.0001" name="Latitude" class="form-control rounded-3" value="23.7500" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Longitude (GPS)</label>
                            <input type="number" step="0.0001" name="Longitude" class="form-control rounded-3" value="90.3800" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Reported Symptoms</label>
                            <textarea name="Symptoms" class="form-control rounded-3" rows="2" placeholder="High fever, retro-orbital pain, body rash, vomiting..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Field Observations & Actions Taken</label>
                            <textarea name="FieldNotes" class="form-control rounded-3" rows="2" placeholder="Visited on site. Advised oral rehydration salts, mosquito netting, paracetamol only."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Next Follow-Up Date & Time</label>
                            <input type="datetime-local" name="NextFollowUpDate" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-6 d-flex align-items-center pt-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsEscalated" value="true" id="checkEscalate">
                                <label class="form-check-label fw-bold text-danger" for="checkEscalate">Escalate to Doctor / Hospital Referral</label>
                            </div>
                        </div>
                        <div class="col-12" id="escalationReasonBox" style="display:none;">
                            <label class="form-label small fw-bold text-danger">Escalation Reason</label>
                            <input type="text" name="EscalationReason" class="form-control rounded-3" placeholder="Critically low platelet, severe vomiting, persistent warning signs" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Register Case</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Update Case Status & Record Follow-up -->
<div class="modal fade" id="modalUpdateCase" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white rounded-top-4">
