                        <label class="form-label small fw-bold">Patient Name <span class="text-danger">*</span></label>
                        <input type="text" name="PatientName" id="referralPatientName" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Patient Phone</label>
                        <input type="text" name="PatientPhone" id="referralPatientPhone" class="form-control rounded-3" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Referral Target</label>
                            <select name="Target" class="form-select rounded-3">
                                <option value="@ReferralTarget.Doctor">Doctor (Consultation / Telemedicine)</option>
                                <option value="@ReferralTarget.Hospital" selected>General Hospital Admission</option>
                                <option value="@ReferralTarget.IcuFacility">ICU / High Dependency Unit</option>
                                <option value="@ReferralTarget.Laboratory">Diagnostic Laboratory</option>
                                <option value="@ReferralTarget.Specialist">Infectious Disease Specialist</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Urgency</label>
                            <select name="Urgency" class="form-select rounded-3">
                                <option value="@ReferralUrgency.Emergency" selected>Emergency (&lt; 2 Hours)</option>
                                <option value="@ReferralUrgency.Urgent">Urgent (&lt; 12 Hours)</option>
                                <option value="@ReferralUrgency.Routine">Routine Follow-up</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Referral Reason <span class="text-danger">*</span></label>
                        <input type="text" name="Reason" class="form-control rounded-3" placeholder="e.g. Platelet drop below 40k, persistent abdominal pain" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Clinical Notes for Receiving Doctor / Facility</label>
                        <textarea name="ClinicalNotes" class="form-control rounded-3" rows="3" placeholder="Include known vital signs, hematocrit trend, fluid administered..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Submit Referral</button>
                </div>
            </form>
        </div>
    </div>
</div>

