                            <select name="Status" id="updateCaseStatus" class="form-select rounded-3">
                                <option value="@CaseStatus.Suspected">Suspected</option>
                                <option value="@CaseStatus.UnderObservation">Under Observation</option>
                                <option value="@CaseStatus.Confirmed">Confirmed</option>
                                <option value="@CaseStatus.Recovering">Recovering</option>
                                <option value="@CaseStatus.Closed">Closed</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Severity</label>
                            <select name="Severity" id="updateCaseSeverity" class="form-select rounded-3">
                                <option value="@CaseSeverity.Mild">Mild</option>
                                <option value="@CaseSeverity.Moderate">Moderate</option>
                                <option value="@CaseSeverity.Severe">Severe</option>
                                <option value="@CaseSeverity.Critical">Critical</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Platelet Count (/μL)</label>
                            <input type="number" name="PlateletCount" id="updateCasePlatelet" class="form-control rounded-3" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Hematocrit (%)</label>
                            <input type="number" step="0.1" name="Hematocrit" id="updateCaseHematocrit" class="form-control rounded-3" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Next Follow-up Scheduled</label>
                        <input type="datetime-local" name="NextFollowUpDate" id="updateCaseFollowUpDate" class="form-control rounded-3" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Field Follow-up Notes</label>
                        <textarea name="FollowUpNotes" class="form-control rounded-3" rows="3" placeholder="Enter today's field observation, fluid intake monitoring, fever trend..."></textarea>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="IsEscalated" value="true" id="updateCheckEscalate">
                        <label class="form-check-label fw-bold text-danger" for="updateCheckEscalate">Mark as Escalated</label>
                    </div>
                    <div id="updateEscalationReasonBox" style="display:none;">
                        <input type="text" name="EscalationReason" class="form-control rounded-3" placeholder="Escalation clinical reason" />
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Review Citizen Report -->
<div class="modal fade" id="modalUpdateReport" tabindex="-1" aria-hidden="true">
