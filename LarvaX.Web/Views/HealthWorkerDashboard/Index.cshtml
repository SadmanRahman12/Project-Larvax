<!-- Modal: Broadcast Sentinel Alert -->
<div class="modal fade" id="modalBroadcastAlert" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-warning text-dark rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-megaphone-fill me-2"></i> Trigger Real-Time Field Alert</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="BroadcastAlert" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="p-3 bg-light rounded-3 border mb-3 small text-muted">
                        <i class="bi bi-broadcast text-danger me-1"></i>
                        This alert will be instantly pushed to connected field workers, clinics, and citizens in the designated radius via SignalR.
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Alert Message <span class="text-danger">*</span></label>
                        <textarea name="Message" class="form-control rounded-3" rows="3" placeholder="High dengue-risk activity detected in Dhanmondi. 3 suspected cases reported within the last 24 hours." required></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Target Zone (Optional)</label>
                            <select name="ZoneId" class="form-select rounded-3">
                                <option value="">District-wide Broadcast</option>
                                @foreach (var z in Model.RiskZones)
                                {
                                    <option value="@z.Id">@z.Region (@z.RiskLevel Risk)</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Coverage Radius (km)</label>
                            <input type="number" step="0.5" name="RadiusKm" class="form-control rounded-3" value="3.0" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Language</label>
                        <select name="Language" class="form-select rounded-3">
                            <option value="en">English</option>
                            <option value="bn">বাংলা (Bangla)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 text-dark fw-bold">Broadcast Now</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        var healthWorkerMap = null;
        var mapBounds = [];

        document.addEventListener("DOMContentLoaded", function () {
            initLeafletMap();

            // Setup escalation checkbox toggle
            const checkEsc = document.getElementById("checkEscalate");
            if (checkEsc) {
                checkEsc.addEventListener("change", function () {
                    document.getElementById("escalationReasonBox").style.display = this.checked ? "block" : "none";
                });
            }

            const updateCheckEsc = document.getElementById("updateCheckEscalate");
            if (updateCheckEsc) {
                updateCheckEsc.addEventListener("change", function () {
                    document.getElementById("updateEscalationReasonBox").style.display = this.checked ? "block" : "none";
                });
            }
        });

        function initLeafletMap() {
            var defaultLat = 23.777176;
            var defaultLng = 90.399452;
            healthWorkerMap = L.map('healthWorkerMap').setView([defaultLat, defaultLng], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(healthWorkerMap);

            mapBounds = [];

            // 1. Plot Risk Zones (Circles)
            var riskZones = [
                @foreach (var z in Model.RiskZones)
                {
                    var col = z.RiskLevel == RiskLevel.High ? "#ef4444" : (z.RiskLevel == RiskLevel.Medium ? "#f59e0b" : "#10b981");
                    @:{ name: "@z.Region", level: "@z.RiskLevel", score: @z.ConfidenceScore, lat: @z.Latitude, lng: @z.Longitude, rad: @z.RadiusMetres, color: "@col" },
                }
            ];

            riskZones.forEach(function (z) {
                if (z.lat && z.lng) {
                    var circle = L.circle([z.lat, z.lng], {
                        color: z.color,
                        fillColor: z.color,
                        fillOpacity: 0.18,
                        weight: 2,
                        radius: z.rad || 1800
                    }).addTo(healthWorkerMap);

                    circle.bindPopup(`
                        <div style="font-family: sans-serif; font-size: 13px;">
                            <strong style="color: ${z.color}; font-size: 14px;">${z.name}</strong><br/>
                            Risk Level: <b>${z.level}</b><br/>
                            Confidence Score: <b>${Math.round(z.score * 100)}%</b>
                        </div>
                    `);
                    mapBounds.push([z.lat, z.lng]);
                }
            });

            // 2. Plot Dengue Cases
            var cases = [
                @foreach (var c in Model.DengueCases)
                {
                    var cCol = c.Status == CaseStatus.Confirmed ? "#b91c1c" : (c.Status == CaseStatus.Suspected ? "#d97706" : "#0284c7");
                    @:{ id: @c.Id, name: "@c.PatientName", status: "@c.Status", severity: "@c.Severity", lat: @c.Latitude, lng: @c.Longitude, color: "@cCol", platelet: @(c.PlateletCount ?? 0) },
                }
            ];

            cases.forEach(function (c) {
                if (c.lat && c.lng) {
                    var caseHtml = `<div style="background-color: ${c.color}; width: 14px; height: 14px; border-radius: 3px; border: 2px solid white; box-shadow: 0 0 5px rgba(0,0,0,0.5);"></div>`;
                    var icon = L.divIcon({ html: caseHtml, className: 'custom-case-icon', iconSize: [14, 14], iconAnchor: [7, 7] });
                    var marker = L.marker([c.lat, c.lng], { icon: icon }).addTo(healthWorkerMap);
                    marker.bindPopup(`
                        <div style="font-family: sans-serif; font-size: 13px;">
                            <strong style="color: ${c.color}; font-size: 14px;">Case #${c.id}: ${c.name}</strong><br/>
                            Status: <b>${c.status}</b> (${c.severity})<br/>
                            Platelet: <b>${c.platelet ? c.platelet.toLocaleString() : 'N/A'} /μL</b>
                        </div>
                    `);
                    mapBounds.push([c.lat, c.lng]);
                }
            });

            // 3. Plot Citizen Reports
            var reports = [
                @foreach (var r in Model.CitizenReports)
                {
                    @:{ id: @r.Id, disease: "@r.DiseaseType", status: "@r.Status", ver: "@r.Verification", lat: @r.Latitude, lng: @r.Longitude },
                }
            ];

            reports.forEach(function (r) {
                if (r.lat && r.lng) {
                    var repHtml = `<div style="background-color: #0284c7; width: 12px; height: 12px; border-radius: 50%; border: 2px solid white; box-shadow: 0 0 4px rgba(0,0,0,0.5);"></div>`;
                    var icon = L.divIcon({ html: repHtml, className: 'custom-rep-icon', iconSize: [12, 12], iconAnchor: [6, 6] });
                    var marker = L.marker([r.lat, r.lng], { icon: icon }).addTo(healthWorkerMap);
                    marker.bindPopup(`
                        <div style="font-family: sans-serif; font-size: 13px;">
                            <strong>Citizen Report #${r.id}</strong><br/>
                            Hazard: ${r.disease}<br/>
                            Status: <b>${r.status}</b> (${r.ver})
                        </div>
                    `);
                    mapBounds.push([r.lat, r.lng]);
                }
            });

            if (mapBounds.length > 0) {
                healthWorkerMap.fitBounds(mapBounds, { padding: [30, 30] });
            }
        }

        function zoomMapTo(lat, lng, popupText) {
            if (healthWorkerMap) {
                healthWorkerMap.setView([lat, lng], 15);
                L.popup().setLatLng([lat, lng]).setContent(`<b>${popupText}</b>`).openOn(healthWorkerMap);
            }
        }

        function resetMapView() {
            if (healthWorkerMap && mapBounds.length > 0) {
                healthWorkerMap.fitBounds(mapBounds, { padding: [30, 30] });
            }
        }

        // ── Client-side Filter Functions ────────────────────────────────────
        function filterCasesTable() {
            var q = document.getElementById("caseSearchInput").value.toLowerCase();
            var rows = document.querySelectorAll("#casesTable tbody .case-row");
            rows.forEach(function (r) {
                r.style.display = r.textContent.toLowerCase().includes(q) ? "" : "none";
            });
        }

        function filterCaseStatus(status, btn) {
            document.querySelectorAll(".filter-case-btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            var rows = document.querySelectorAll("#casesTable tbody .case-row");
            rows.forEach(function (r) {
                if (status === 'ALL') {
                    r.style.display = "";
                } else if (status === 'Escalated') {
                    r.style.display = r.getAttribute("data-escalated") === "true" ? "" : "none";
                } else {
                    r.style.display = r.getAttribute("data-status") === status ? "" : "none";
                }
            });
        }

        function filterReportsTable() {
            var q = document.getElementById("reportSearchInput").value.toLowerCase();
            var rows = document.querySelectorAll("#reportsTable tbody .report-row");
            rows.forEach(function (r) {
                r.style.display = r.textContent.toLowerCase().includes(q) ? "" : "none";
            });
        }

        function filterReportStatus(status, btn) {
            document.querySelectorAll(".filter-report-btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            var rows = document.querySelectorAll("#reportsTable tbody .report-row");
            rows.forEach(function (r) {
                if (status === 'ALL') {
                    r.style.display = "";
                } else {
                    r.style.display = r.getAttribute("data-status") === status ? "" : "none";
                }
            });
        }

        function filterDonors() {
            var q = document.getElementById("donorSearchInput").value.toLowerCase();
            var items = document.querySelectorAll("#donorListGrid .donor-card-item");
            items.forEach(function (i) {
                i.style.display = i.textContent.toLowerCase().includes(q) ? "" : "none";
            });
        }

        function filterDonorBg(bg, btn) {
            document.querySelectorAll(".filter-donor-btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            var items = document.querySelectorAll("#donorListGrid .donor-card-item");
            items.forEach(function (i) {
                if (bg === 'ALL') {
                    i.style.display = "";
                } else {
                    i.style.display = i.getAttribute("data-bg") === bg ? "" : "none";
                }
            });
        }

        // ── Modal Helper Openers ─────────────────────────────────────────────
        function openUpdateCaseModal(id, name, status, severity, platelet, hematocrit, followUpDate, isEscalated) {
            document.getElementById("updateCaseId").value = id;
            document.getElementById("updateCasePatientName").value = "#" + id + " - " + name;
            document.getElementById("updateCaseStatus").value = status;
            document.getElementById("updateCaseSeverity").value = severity;
            document.getElementById("updateCasePlatelet").value = platelet > 0 ? platelet : "";
            document.getElementById("updateCaseHematocrit").value = hematocrit > 0 ? hematocrit : "";
            document.getElementById("updateCaseFollowUpDate").value = followUpDate || "";
            document.getElementById("updateCheckEscalate").checked = isEscalated;
            document.getElementById("updateEscalationReasonBox").style.display = isEscalated ? "block" : "none";
            var modal = new bootstrap.Modal(document.getElementById("modalUpdateCase"));
            modal.show();
        }

        function openUpdateReportModal(id, status, verification, notes) {
            document.getElementById("updateReportId").value = id;
            document.getElementById("updateReportStatus").value = status;
            document.getElementById("updateReportVerification").value = verification;
            document.getElementById("updateReportNotes").value = notes;
            var modal = new bootstrap.Modal(document.getElementById("modalUpdateReport"));
            modal.show();
        }

        function openDispenseModal(itemId, itemName, currentQty) {
            document.getElementById("adjustItemId").value = itemId;
            document.getElementById("adjustQtyChange").value = -1;
            var modal = new bootstrap.Modal(document.getElementById("modalAdjustInventory"));
            modal.show();
        }

        function openReferralModal(caseId, patientName, patientPhone) {
            document.getElementById("referralCaseId").value = caseId;
            document.getElementById("referralPatientName").value = patientName;
            document.getElementById("referralPatientPhone").value = patientPhone;
            var modal = new bootstrap.Modal(document.getElementById("modalCreateReferral"));
            modal.show();
        }
    </script>
}
